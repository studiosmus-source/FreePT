{
  "name": "freept",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test:bridge": "node --test bridge/*.test.mjs",
    "test:desktop": "node --test desktop/*.test.mjs",
    "desktop:build": "npm run build && npx --yes electron-builder@26.18.0 --config desktop/electron-builder.yml --publish never",
    "bridge:staging": "node bridge/runStaging.mjs",
    "bridge:serve:staging": "node bridge/runHttpsStaging.mjs",
    "bridge:serve:production": "node bridge/runProduction.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@supabase/supabase-js": "^2.57.0",
    "tus-js-client": "^4.3.1",
    "@capacitor/push-notifications": "^7.0.0",
    "vite": "^7.1.0"
  }
}
