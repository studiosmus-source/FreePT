package __PACKAGE__;

import android.os.Build;
import android.os.Environment;
import android.content.Context;
import android.os.storage.StorageManager;
import android.os.storage.StorageVolume;
import android.util.Base64;
import android.util.Log;
import com.getcapacitor.JSArray;
import com.getcapacitor.JSObject;
import java.io.File;
import java.io.RandomAccessFile;
import java.io.IOException;
import java.util.Arrays;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.HashMap;
import java.util.Map;
import java.util.LinkedHashMap;
import java.nio.charset.StandardCharsets;
import java.util.UUID;

/**
 * Thread-safe, process-local shared-storage catalogue.
 * Android controls accessible locations. No network or permission requests here.
 * All handles are opaque and only created from descendants of the storage root.
 * Used by both the Capacitor file browser and the foreground TX worker.
 */
final class BridgeAllFilesCore {
    private BridgeAllFilesCore(){}
    private static final int PAGE=100,MAX_HANDLES=60000,MAX_CHUNK=262144;
    private static final long MAX_BYTES=Long.MAX_VALUE-MAX_CHUNK;
    private static final Map<String, Entry> entries=new HashMap<>();
    private static final Map<String,String> reverse=new HashMap<>();
    private static File root;
    private static Context appContext;
    private static final Map<String,Entry> extraVolumes=new LinkedHashMap<>();
    // One bounded session-local snapshot. Page 2+ must not rescan and
    // canonicalize every sibling in a large folder again and again.
    private static final long SNAPSHOT_NANOS=300_000_000_000L;
    private static DirectorySnapshot lastSnapshot;
    private static final class DirectorySnapshot {
        final String handle;
        final File folder;
        final File[] visible;
        final int rawFiles,rawDirs,skipped;
        final long created;
        DirectorySnapshot(String handle,File folder,File[] visible,
                          int rawFiles,int rawDirs,int skipped){
            this.handle=handle;this.folder=folder;this.visible=visible;
            this.rawFiles=rawFiles;this.rawDirs=rawDirs;this.skipped=skipped;
            this.created=System.nanoTime();
        }
    }
    static synchronized void configure(Context context){
        if(context!=null)appContext=context.getApplicationContext();
    }

    private static final class Entry {
        final File file;
        final int depth;
        final File volumeRoot;
        Entry(File file,int depth,File volumeRoot){
            this.file=file;this.depth=depth;this.volumeRoot=volumeRoot;
        }
    }
    static synchronized boolean granted(){
        return Build.VERSION.SDK_INT>=30 && Environment.isExternalStorageManager();
    }
    private static boolean prepare(){
        if(!granted()){
            entries.clear();reverse.clear();extraVolumes.clear();lastSnapshot=null;root=null;return false;
        }
        try{
            File candidate=Environment.getExternalStorageDirectory().getCanonicalFile();
            if(root==null||!root.equals(candidate)){
                root=candidate;
                entries.clear();reverse.clear();extraVolumes.clear();lastSnapshot=null;
                entries.put("root",new Entry(root,0,root));
            }
            // Only currently mounted, readable shared volumes. Do not try
            // Android/data, app-private storage or arbitrary /storage paths.
            extraVolumes.clear();
            if(Build.VERSION.SDK_INT>=30&&appContext!=null){
                StorageManager manager=(StorageManager)appContext.getSystemService(Context.STORAGE_SERVICE);
                if(manager!=null){
                    int volumeIndex=0;
                    for(StorageVolume volume:manager.getStorageVolumes()){
                        if(volume.isPrimary()||!Environment.MEDIA_MOUNTED.equals(volume.getState()))
                            continue;
                        File directory=volume.getDirectory();
                        if(directory==null||!directory.isDirectory()||!directory.canRead())
                            continue;
                        File canonical=directory.getCanonicalFile();
                        if(canonical.equals(root))continue;
                        String id=UUID.nameUUIDFromBytes(("freept-shared-volume:"+canonical.getPath())
                            .getBytes(StandardCharsets.UTF_8)).toString();
                        Entry mount=new Entry(canonical,0,canonical);
                        extraVolumes.put(id,mount);
                        entries.put(id,mount);
                        volumeIndex++;
                    }
                }
            }
            return true;
        }catch(IOException error){return false;}
    }
    /** Reject handles retained from a removable volume that is no longer mounted. */
    private static boolean currentVolume(Entry item){
        if(item.volumeRoot.equals(root))return true;
        for(Entry mounted:extraVolumes.values())
            if(mounted.volumeRoot.equals(item.volumeRoot))return true;
        return false;
    }
    private static boolean valid(File file,File volumeRoot){
        String name=file.getName();
        if(name.isEmpty()||name.length()>255||name.equals(".")||name.equals("..")||
           name.indexOf('/')>=0||name.indexOf('\\')>=0)return false;
        for(int i=0;i<name.length();i++){
            char c=name.charAt(i);
            if(c<32||c==127)return false;
        }
        try{
            String base=volumeRoot.getCanonicalPath();
            String canonical=file.getCanonicalPath();
            if(!canonical.startsWith(base+File.separator))return false;
            String relative=canonical.substring(base.length()+1).replace(File.separatorChar,'/');
            if(relative.equals("Android/data")||relative.startsWith("Android/data/")||
               relative.equals("Android/obb")||relative.startsWith("Android/obb/"))return false;
            // Never follow filesystem symlinks or directory traversal.
            if(!file.getCanonicalFile().equals(file.getAbsoluteFile()))return false;
            return file.isDirectory()||(file.isFile()&&file.length()<=MAX_BYTES);
        }catch(IOException error){return false;}
    }
    private static DirectorySnapshot snapshotFor(String handle,Entry parent,int offset)
            throws Exception {
        DirectorySnapshot cached=lastSnapshot;
        if(offset>0&&cached!=null&&cached.handle.equals(handle)&&
            cached.folder.equals(parent.file)&&
            System.nanoTime()-cached.created<SNAPSHOT_NANOS)return cached;
        File[] raw=parent.file.listFiles();
        if(raw==null)throw new IOException("unreadable_directory");
        ArrayList<File> accepted=new ArrayList<>(raw.length);
        int fileCount=0,dirCount=0,skipped=0;
        for(File candidate:raw){
            if(candidate.isFile())fileCount++;
            else if(candidate.isDirectory())dirCount++;
            if(valid(candidate,parent.volumeRoot))accepted.add(candidate);
            else skipped++;
        }
        // Sort the WHOLE validated catalogue before slicing into pages.
        // Sorting each page in RX would put some files before later folders.
        accepted.sort(Comparator
            .comparing((File item)->!item.isDirectory())
            .thenComparing(File::getName,String.CASE_INSENSITIVE_ORDER)
            .thenComparing(File::getName));
        DirectorySnapshot next=new DirectorySnapshot(handle,parent.file,
            accepted.toArray(new File[0]),fileCount,dirCount,skipped);
        lastSnapshot=next;
        return next;
    }
    static synchronized JSObject list(String handle,int offset)throws Exception {
        if(!prepare())throw new SecurityException("bridge_all_files_not_granted");
        if(offset<0||offset>MAX_HANDLES)throw new IllegalArgumentException("offset");
        Entry parent=entries.get(handle);
        if(parent==null||!currentVolume(parent)||!parent.file.isDirectory()||parent.depth>=128)
            throw new SecurityException("invalid_directory");
        DirectorySnapshot snapshot=snapshotFor(handle,parent,offset);
        JSArray list=new JSArray();
        int counted=0,emitted=0;
        boolean hasMore=false;
        // Extra mounted shared volumes appear beside the primary root.
        if("root".equals(handle)){
            int index=0;
            for(Map.Entry<String,Entry> volume:extraVolumes.entrySet()){
                index++;
                if(counted++<offset)continue;
                if(emitted>=PAGE){hasMore=true;break;}
                JSObject mount=new JSObject();
                mount.put("handle",volume.getKey());
                mount.put("name","Memoria aggiuntiva "+index);
                mount.put("directory",true);
                mount.put("size",-1);
                mount.put("mime","vnd.android.document/directory");
                list.put(mount);emitted++;
            }
        }
        if(!hasMore)for(File file:snapshot.visible){
            if(counted++<offset)continue;
            if(emitted>=PAGE){hasMore=true;break;}
            // A cached page never bypasses permissions or symlink checks.
            if(!valid(file,parent.volumeRoot))
                throw new IOException("catalogue_changed_retry");
            String key=file.getCanonicalPath();
            String id=reverse.get(key);
            if(id==null){
                if(entries.size()>=MAX_HANDLES)throw new IOException("handle_limit");
                id=UUID.randomUUID().toString();
                reverse.put(key,id);
                entries.put(id,new Entry(file,parent.depth+1,parent.volumeRoot));
            }
            boolean directory=file.isDirectory();
            JSObject item=new JSObject();
            item.put("handle",id);
            item.put("name",file.getName());
            item.put("directory",directory);
            item.put("size",directory?-1:file.length());
            String mime=directory?"vnd.android.document/directory":
                java.net.URLConnection.guessContentTypeFromName(file.getName());
            item.put("mime",mime==null?"application/octet-stream":mime);
            list.put(item);
            emitted++;
        }
        if(offset==0){
            Log.i("FreePTBridgeCatalogue","files="+snapshot.rawFiles+
                " dirs="+snapshot.rawDirs+" accepted="+snapshot.visible.length+
                " skipped="+snapshot.skipped+" emitted="+emitted);
        }
        if(offset==0&&snapshot.visible.length==0&&snapshot.skipped>0&&
           emitted==0)
            throw new IOException("directory_entries_inaccessible");
        JSObject out=new JSObject();
        out.put("entries",list);
        out.put("nextOffset",hasMore?offset+emitted:-1);
        return out;
    }
    static synchronized JSObject read(String handle,long offset,int length)throws Exception{
        if(!prepare())throw new SecurityException("bridge_all_files_not_granted");
        Entry entry=entries.get(handle);
        if(entry==null||!currentVolume(entry)||!entry.file.isFile()||
           !valid(entry.file,entry.volumeRoot)||!entry.file.canRead()||
           offset<0||offset>MAX_BYTES||length<1||length>MAX_CHUNK||
           offset>MAX_BYTES-length)
            throw new SecurityException("invalid_file_request");
        try(RandomAccessFile file=new RandomAccessFile(entry.file,"r")){
            file.seek(offset);
            byte[] buffer=new byte[length];
            int count=0;
            while(count<length){
                int read=file.read(buffer,count,length-count);
                if(read<0)break;
                if(read==0)throw new IOException("no_read_progress");
                count+=read;
            }
            JSObject out=new JSObject();
            out.put("base64",Base64.encodeToString(Arrays.copyOf(buffer,count),Base64.NO_WRAP));
            out.put("bytesRead",count);
            out.put("eof",offset+count>=file.length());
            return out;
        }
    }
}
