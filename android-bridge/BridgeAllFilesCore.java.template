package __PACKAGE__;

import android.os.Build;
import android.os.Environment;
import android.util.Base64;
import android.util.Log;
import com.getcapacitor.JSArray;
import com.getcapacitor.JSObject;
import java.io.File;
import java.io.RandomAccessFile;
import java.io.IOException;
import java.util.Arrays;
import java.util.Comparator;
import java.util.HashMap;
import java.util.Map;
import java.util.UUID;

/**
 * Thread-safe, process-local shared-storage catalogue.
 * Android controls accessible locations. No network or permission requests here.
 * All handles are opaque and only created from descendants of the storage root.
 * Used by both the Capacitor file browser and the foreground TX worker.
 */
final class BridgeAllFilesCore {
    private BridgeAllFilesCore(){}
    private static final int PAGE=100,MAX_HANDLES=12000,MAX_CHUNK=32768;
    private static final long MAX_BYTES=1099511627776L;
    private static final Map<String, Entry> entries=new HashMap<>();
    private static final Map<String,String> reverse=new HashMap<>();
    private static File root;

    private static final class Entry {
        final File file;
        final int depth;
        Entry(File file,int depth){this.file=file;this.depth=depth;}
    }
    static synchronized boolean granted(){
        return Build.VERSION.SDK_INT>=30 && Environment.isExternalStorageManager();
    }
    private static boolean prepare(){
        if(!granted()){
            entries.clear();reverse.clear();root=null;return false;
        }
        try{
            File candidate=Environment.getExternalStorageDirectory().getCanonicalFile();
            if(root==null||!root.equals(candidate)){
                root=candidate;
                entries.clear();reverse.clear();
                entries.put("root",new Entry(root,0));
            }
            return true;
        }catch(IOException error){return false;}
    }
    private static boolean valid(File file){
        String name=file.getName();
        if(name.isEmpty()||name.length()>255||name.equals(".")||name.equals("..")||
           name.indexOf('/')>=0||name.indexOf('\\')>=0)return false;
        for(int i=0;i<name.length();i++){
            char c=name.charAt(i);
            if(c<32||c==127)return false;
        }
        try{
            String base=root.getCanonicalPath();
            String canonical=file.getCanonicalPath();
            if(!canonical.startsWith(base+File.separator))return false;
            // Never follow filesystem symlinks or directory traversal.
            if(!file.getCanonicalFile().equals(file.getAbsoluteFile()))return false;
            return file.isDirectory()||(file.isFile()&&file.length()<=MAX_BYTES);
        }catch(IOException error){return false;}
    }
    static synchronized JSObject list(String handle,int offset)throws Exception {
        if(!prepare())throw new SecurityException("bridge_all_files_not_granted");
        if(offset<0||offset>10000)throw new IllegalArgumentException("offset");
        Entry parent=entries.get(handle);
        if(parent==null||!parent.file.isDirectory()||parent.depth>=32)
            throw new SecurityException("invalid_directory");
        File[] children=parent.file.listFiles();
        if(children==null)throw new IOException("unreadable_directory");
        Arrays.sort(children,Comparator.comparing(File::getName));
        JSArray list=new JSArray();
        int counted=0,emitted=0,skipped=0;
        boolean hasMore=false;
        for(File file:children){
            if(!valid(file)){skipped++;continue;}
            if(counted++<offset)continue;
            if(emitted>=PAGE){hasMore=true;break;}
            String key=file.getCanonicalPath();
            String id=reverse.get(key);
            if(id==null){
                if(entries.size()>=MAX_HANDLES)throw new IOException("handle_limit");
                id=UUID.randomUUID().toString();
                reverse.put(key,id);
                entries.put(id,new Entry(file,parent.depth+1));
            }
            boolean directory=file.isDirectory();
            JSObject item=new JSObject();
            item.put("handle",id);
            item.put("name",file.getName());
            item.put("directory",directory);
            item.put("size",directory?-1:file.length());
            String mime=directory?"vnd.android.document/directory":
                java.net.URLConnection.guessContentTypeFromName(file.getName());
            item.put("mime",mime==null?"application/octet-stream":mime);
            list.put(item);
            emitted++;
        }
        JSObject out=new JSObject();
        if(offset==0 && counted==0 && skipped>0)
            throw new IOException("directory_entries_inaccessible");
        out.put("entries",list);
        out.put("nextOffset",hasMore?offset+emitted:-1);
        return out;
    }
    static synchronized JSObject read(String handle,long offset,int length)throws Exception{
        if(!prepare())throw new SecurityException("bridge_all_files_not_granted");
        Entry entry=entries.get(handle);
        if(entry==null||!entry.file.isFile()||!valid(entry.file)||!entry.file.canRead()||
           offset<0||offset>MAX_BYTES||length<1||length>MAX_CHUNK||
           offset>MAX_BYTES-length)
            throw new SecurityException("invalid_file_request");
        try(RandomAccessFile file=new RandomAccessFile(entry.file,"r")){
            file.seek(offset);
            byte[] buffer=new byte[length];
            int count=0;
            while(count<length){
                int read=file.read(buffer,count,length-count);
                if(read<0)break;
                if(read==0)throw new IOException("no_read_progress");
                count+=read;
            }
            JSObject out=new JSObject();
            out.put("base64",Base64.encodeToString(Arrays.copyOf(buffer,count),Base64.NO_WRAP));
            out.put("bytesRead",count);
            out.put("eof",offset+count>=file.length());
            return out;
        }
    }
}