package __PACKAGE__;

import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.CapacitorPlugin;

/** Keystore-backed Bridge device provisioning. Never stores raw keys in JS storage. */
@CapacitorPlugin(name="BridgeCredentials")
public class BridgeCredentialsPlugin extends Plugin {
    @PluginMethod public void provision(PluginCall call){
        try{
            BridgeDeviceSecretStore.save(getContext(),
                call.getString("deviceId"),call.getString("deviceSecret"));
            JSObject out=new JSObject();out.put("saved",true);call.resolve(out);
        }catch(Exception error){call.reject("bridge_credentials_store_failed");}
    }
    @PluginMethod public void status(PluginCall call){
        JSObject out=new JSObject();
        boolean configured=BridgeDeviceSecretStore.configured(getContext());
        out.put("provisioned",configured);
        if(configured)out.put("deviceId",BridgeDeviceSecretStore.deviceId(getContext()));
        call.resolve(out);
    }
    @PluginMethod public void getForConnection(PluginCall call){
        try{
            BridgeDeviceSecretStore.Credentials c=BridgeDeviceSecretStore.read(getContext());
            JSObject out=new JSObject();
            out.put("deviceId",c.deviceId);out.put("deviceSecret",c.deviceSecret);
            call.resolve(out);
        }catch(Exception error){call.reject("bridge_credentials_unavailable");}
    }
    @PluginMethod public void clear(PluginCall call){
        try{
            BridgeDeviceSecretStore.clear(getContext());
            JSObject out=new JSObject();out.put("cleared",true);call.resolve(out);
        }catch(Exception error){call.reject("bridge_credentials_clear_failed");}
    }
}