package __PACKAGE__;

import android.security.keystore.KeyGenParameterSpec;
import android.security.keystore.KeyProperties;
import android.util.Base64;
import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.CapacitorPlugin;
import java.nio.charset.StandardCharsets;
import java.security.KeyStore;
import java.security.SecureRandom;
import javax.crypto.Cipher;
import javax.crypto.KeyGenerator;
import javax.crypto.SecretKey;
import javax.crypto.spec.GCMParameterSpec;

/**
 * Android-only isolated Bridge TX provisioning. The device bearer secret is
 * encrypted at rest using the Android Keystore, never hardcoded into the APK.
 * Storing a secret is NOT consent to start a connection or share any folder.
 */
@CapacitorPlugin(name="BridgeCredentials")
public class BridgeCredentialsPlugin extends Plugin {
    private static final String KEY_ALIAS="it.freept.bridge.device.v1";
    private static final String PREFS="freept_bridge_credentials";
    private static final String DEVICE="id";
    private static final String ENC="encrypted";
    private static final String UUID="(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$";
    private static final String HEX="^[0-9a-f]{64}$";
    private static final String STORE="AndroidKeyStore";

    private SecretKey key() throws Exception {
        KeyStore store=KeyStore.getInstance(STORE);
        store.load(null);
        java.security.Key existing=store.getKey(KEY_ALIAS,null);
        if(existing instanceof SecretKey)return (SecretKey)existing;
        KeyGenerator generator=KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES,STORE);
        generator.init(new KeyGenParameterSpec.Builder(KEY_ALIAS,
                KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
                .setKeySize(256)
                .build());
        return generator.generateKey();
    }

    @PluginMethod
    public void provision(PluginCall call) {
        final String id=call.getString("deviceId");
        final String secret=call.getString("deviceSecret");
        if(id==null||secret==null||!id.matches(UUID)||!secret.matches(HEX)){
            call.reject("bridge_credentials_invalid");return;
        }
        try{
            Cipher cipher=Cipher.getInstance("AES/GCM/NoPadding");
            cipher.init(Cipher.ENCRYPT_MODE,key());
            byte[] sealed=cipher.doFinal(secret.getBytes(StandardCharsets.US_ASCII));
            byte[] nonce=cipher.getIV();
            if(nonce==null||nonce.length!=12)throw new IllegalStateException();
            byte[] stored=new byte[nonce.length+sealed.length];
            System.arraycopy(nonce,0,stored,0,nonce.length);
            System.arraycopy(sealed,0,stored,nonce.length,sealed.length);
            boolean saved=getContext().getSharedPreferences(PREFS,0).edit()
                .putString(DEVICE,id)
                .putString(ENC,Base64.encodeToString(stored,Base64.NO_WRAP))
                .commit();
            if(!saved)throw new IllegalStateException();
            JSObject response=new JSObject();response.put("saved",true);
            call.resolve(response);
        }catch(Exception e){call.reject("bridge_credentials_store_failed");}
    }

    @PluginMethod
    public void status(PluginCall call) {
        String id=getContext().getSharedPreferences(PREFS,0).getString(DEVICE,null);
        String sealed=getContext().getSharedPreferences(PREFS,0).getString(ENC,null);
        JSObject result=new JSObject();
        result.put("provisioned",id!=null&&id.matches(UUID)&&sealed!=null);
        // Never expose the TX secret to a simple status check.
        if(id!=null&&id.matches(UUID)&&sealed!=null)result.put("deviceId",id);
        call.resolve(result);
    }

    @PluginMethod
    public void getForConnection(PluginCall call) {
        final String id=getContext().getSharedPreferences(PREFS,0).getString(DEVICE,null);
        final String encrypted=getContext().getSharedPreferences(PREFS,0).getString(ENC,null);
        if(id==null||!id.matches(UUID)||encrypted==null){
            call.reject("bridge_credentials_absent");return;
        }
        try{
            byte[] bytes=Base64.decode(encrypted,Base64.DEFAULT);
            if(bytes.length<29)throw new IllegalStateException();
            byte[] nonce=java.util.Arrays.copyOfRange(bytes,0,12);
            byte[] ciphertext=java.util.Arrays.copyOfRange(bytes,12,bytes.length);
            Cipher cipher=Cipher.getInstance("AES/GCM/NoPadding");
            cipher.init(Cipher.DECRYPT_MODE,key(),new GCMParameterSpec(128,nonce));
            String secret=new String(cipher.doFinal(ciphertext),StandardCharsets.US_ASCII);
            if(!secret.matches(HEX))throw new IllegalStateException();
            JSObject result=new JSObject();
            result.put("deviceId",id);
            result.put("deviceSecret",secret);
            call.resolve(result);
        }catch(Exception e){
            call.reject("bridge_credentials_unavailable");
        }
    }

    @PluginMethod
    public void clear(PluginCall call) {
        boolean cleared=getContext().getSharedPreferences(PREFS,0).edit().clear().commit();
        try{
            KeyStore store=KeyStore.getInstance(STORE);store.load(null);
            if(store.containsAlias(KEY_ALIAS))store.deleteEntry(KEY_ALIAS);
        }catch(Exception ignored){}
        if(!cleared){call.reject("bridge_credentials_clear_failed");return;}
        JSObject result=new JSObject();result.put("cleared",true);call.resolve(result);
    }
}
