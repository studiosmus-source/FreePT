package __PACKAGE__;

import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.CapacitorPlugin;

/** Keystore-backed Bridge device provisioning. Never stores raw keys in JS storage. */
@CapacitorPlugin(name="BridgeCredentials")
public class BridgeCredentialsPlugin extends Plugin {
    @PluginMethod public void provision(PluginCall call){
        try{
            BridgeDeviceSecretStore.save(getContext(),
                call.getString("deviceId"),call.getString("deviceSecret"));
            JSObject out=new JSObject();out.put("saved",true);call.resolve(out);
        }catch(Exception error){call.reject("bridge_credentials_store_failed");}
    }
    @PluginMethod public void status(PluginCall call){
        JSObject out=new JSObject();
        boolean configured=BridgeDeviceSecretStore.configured(getContext());
        out.put("provisioned",configured);
        if(configured)out.put("deviceId",BridgeDeviceSecretStore.deviceId(getContext()));
        call.resolve(out);
    }
    @PluginMethod public void getForConnection(PluginCall call){
        try{
            BridgeDeviceSecretStore.Credentials c=BridgeDeviceSecretStore.read(getContext());
            JSObject out=new JSObject();
            out.put("deviceId",c.deviceId);out.put("deviceSecret",c.deviceSecret);
            call.resolve(out);
        }catch(Exception error){call.reject("bridge_credentials_unavailable");}
    }
    @PluginMethod public void clear(PluginCall call){
        try{
            BridgeDeviceSecretStore.clear(getContext());
            JSObject out=new JSObject();out.put("cleared",true);call.resolve(out);
        }catch(Exception error){call.reject("bridge_credentials_clear_failed");}
    }

    /**
     * Android HTTPS owner enrollment, independent of WebView CORS.
     * The native endpoint is injected at build-time and is never caller-selected.
     * Never log tokens, file paths, response bodies, or device secrets.
     */
    @PluginMethod public void ownerRequest(PluginCall call){
        final String action=call.getString("action","");
        final String token=call.getString("accessToken","");
        final JSObject payload=call.getObject("payload");
        if(!("enroll".equals(action)||"delete".equals(action))||
           token==null||token.length()<20||token.length()>8192||
           token.indexOf('\n')>=0||token.indexOf('\r')>=0||
           payload==null){
            call.reject("bridge_owner_native_invalid_request");return;
        }
        if("enroll".equals(action)){
            String label=payload.getString("label","");
            if(payload.length()!=1||label==null||label.trim().isEmpty()||
               label.length()>100){
                call.reject("bridge_owner_native_invalid_request");return;
            }
        }else{
            String deviceId=payload.getString("deviceId","");
            if(payload.length()!=1||deviceId==null||
               !deviceId.matches("(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$")){
                call.reject("bridge_owner_native_invalid_request");return;
            }
        }
        new Thread(()->{
            java.net.HttpURLConnection conn=null;
            try{
                int id=getContext().getResources().getIdentifier(
                    "bridge_endpoint","string",getContext().getPackageName());
                if(id==0)throw new java.io.IOException("endpoint_missing");
                String endpoint=getContext().getString(id);
                java.net.URL root=new java.net.URL(endpoint);
                if(!"https".equals(root.getProtocol())||
                   root.getHost()==null||root.getHost().isEmpty()||
                   root.getPort()!=-1||!root.getPath().matches("/?")||
                   root.getQuery()!=null||root.getRef()!=null)
                    throw new java.io.IOException("endpoint_invalid");
                byte[] bytes=payload.toString().getBytes(
                    java.nio.charset.StandardCharsets.UTF_8);
                if(bytes.length>2048)throw new java.io.IOException("request_too_large");
                conn=(java.net.HttpURLConnection)new java.net.URL(
                    endpoint+"/bridge/owner/"+action).openConnection();
                conn.setInstanceFollowRedirects(false);
                conn.setConnectTimeout(12000);
                conn.setReadTimeout(20000);
                conn.setRequestMethod("POST");
                conn.setDoOutput(true);
                conn.setRequestProperty("Content-Type","application/json");
                conn.setRequestProperty("Accept","application/json");
                conn.setRequestProperty("Authorization","Bearer "+token);
                try(java.io.OutputStream out=conn.getOutputStream()){out.write(bytes);}
                final int code=conn.getResponseCode();
                if(code!=200&&code!=201){
                    if(code==401||code==403)call.reject("bridge_owner_denied");
                    else call.reject("bridge_owner_request_failed");
                    return;
                }
                java.io.ByteArrayOutputStream buffer=new java.io.ByteArrayOutputStream();
                try(java.io.InputStream in=conn.getInputStream()){
                    byte[] chunk=new byte[2048];int n;
                    while((n=in.read(chunk))!=-1){
                        if(buffer.size()+n>8192)throw new java.io.IOException("response_too_large");
                        buffer.write(chunk,0,n);
                    }
                }
                org.json.JSONObject answer=new org.json.JSONObject(
                    buffer.toString("UTF-8"));
                JSObject result=new JSObject();
                if("enroll".equals(action)){
                    result.put("deviceId",answer.getString("deviceId"));
                    result.put("deviceSecret",answer.getString("deviceSecret"));
                }else{
                    result.put("deleted",answer.getBoolean("deleted"));
                }
                call.resolve(result);
            }catch(java.io.IOException error){
                call.reject("bridge_owner_native_network");
            }catch(Exception error){
                call.reject("bridge_owner_native_invalid_response");
            }finally{
                if(conn!=null)conn.disconnect();
            }
        },"freept-owner-https").start();
    }
}