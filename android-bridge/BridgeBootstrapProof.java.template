package __PACKAGE__;

/** Pure wire-format/fixture implementation, shared by Android TX and JVM tests. */
public final class BridgeBootstrapProof {
 private BridgeBootstrapProof(){}
 public static String message(String action,String id,long timestamp,String nonce,String payload){
  return "freept-bootstrap-v1\n"+action+"\n"+id+"\n"+timestamp+"\n"+nonce+"\n"+payload;
 }
 public static byte[] fixture(String challenge){
  if(challenge==null||!challenge.matches("[0-9a-f]{64}"))throw new IllegalArgumentException();
  byte[] seed=new byte[32],all=new byte[300000];
  for(int i=0;i<32;i++)seed[i]=(byte)Integer.parseInt(challenge.substring(i*2,i*2+2),16);
  for(int i=0;i<all.length;i++)all[i]=(byte)(seed[i%32]^(i&255));return all;
 }
}
