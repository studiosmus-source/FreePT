 @Test public void providerReturningExistingDocumentCannotOverwriteIt()throws Exception{
  Doc previous=add("root","keep.bin","application/octet-stream");Files.write(previous.bytes.toPath(),new byte[]{9,8,7});returnExisting=previous.id;
  Call c=call(Map.of("ownerId",A,"ownerName","Cristina","name","unsafe.bin","size",0,"mime","application/octet-stream"));plugin.beginSingleFile(c.call);assertNotNull(c.error);
  assertArrayEquals(new byte[]{9,8,7},Files.readAllBytes(previous.bytes.toPath()));assertTrue(docs.containsKey(previous.id));
 }

 @Test public void chatAndRemoteFolderUseSameOwnerAndPreserveNestedPaths()throws Exception{
  finish(begin(A,"chat.bin",0),new byte[0]);
  Call c=call(Map.of("ownerId",A,"ownerName","Cristina","name","DownloadTelefono"));plugin.beginFolder(c.call);assertNull(c.error);assertTrue(c.result.getBoolean("started"));
  c=call(Map.of("path",List.of("sub")));plugin.makeDirectory(c.call);assertNull(c.error);
  Map<String,Object> args=Map.of("path",List.of("sub","remote.bin"),"size",4,"mime","application/octet-stream");
  c=call(args);plugin.openFile(c.call);assertNull(c.error);String id=c.result.getString("fileId");
  c=call(args);plugin.openFile(c.call);assertNotNull(c.error);
  c=call(Map.of("path",List.of("sub","remote.bin")));plugin.makeDirectory(c.call);assertNotNull(c.error);
  c=call(Map.of("path",List.of("..")));plugin.makeDirectory(c.call);assertNotNull(c.error);
  c=call(Map.of("fileId",id,"offset",0,"base64","AQIDBA=="));plugin.writeChunk(c.call);assertNull(c.error);
  c=call(Map.of("fileId",id));plugin.commitFile(c.call);assertNull(c.error);
  c=call(Map.of());plugin.commitFolder(c.call);assertNull(c.error);
  assertEquals(1,docs.values().stream().filter(d->"root".equals(d.parent)).count());
  Doc owner=docs.values().stream().filter(d->"Cristina".equals(d.name)).findFirst().orElseThrow();
  Doc folder=docs.values().stream().filter(d->"DownloadTelefono".equals(d.name)).findFirst().orElseThrow();
  Doc sub=docs.values().stream().filter(d->"sub".equals(d.name)).findFirst().orElseThrow();
  Doc file=docs.values().stream().filter(d->"remote.bin".equals(d.name)).findFirst().orElseThrow();
  assertEquals(owner.id,folder.parent);assertEquals(folder.id,sub.parent);assertEquals(sub.id,file.parent);
  assertArrayEquals(new byte[]{1,2,3,4},Files.readAllBytes(file.bytes.toPath()));
 }
 @Test public void voluntaryCancellationKeepsOnlyCompleteFilesInPartialFolder()throws Exception{
  Call started=call(Map.of("ownerId",A,"ownerName","Cristina","name","Foto"));
  plugin.beginFolder(started.call);assertNull(started.error);
  Call complete=call(Map.of("path",List.of("one.bin"),"size",3,"mime","application/octet-stream"));
  plugin.openFile(complete.call);assertNull(complete.error);
  String completeId=complete.result.getString("fileId");
  Call written=call(Map.of("fileId",completeId,"offset",0,"base64","AQID"));
  plugin.writeChunk(written.call);assertNull(written.error);
  Call verified=call(Map.of("fileId",completeId));
  plugin.commitFile(verified.call);assertNull(verified.error);
  Call interrupted=call(Map.of("path",List.of("two.bin"),"size",100,"mime","application/octet-stream"));
  plugin.openFile(interrupted.call);assertNull(interrupted.error);
  String incompleteId=interrupted.result.getString("fileId");
  Call partialWrite=call(Map.of("fileId",incompleteId,"offset",0,"base64","BAU="));
  plugin.writeChunk(partialWrite.call);assertNull(partialWrite.error);
  Call removePartial=call(Map.of("fileId",incompleteId));
  plugin.discardFile(removePartial.call);assertNull(removePartial.error);
  Call publish=call(Map.of("partial",true));
  plugin.commitFolder(publish.call);assertNull(publish.error);
  assertEquals("Foto (parziale)",publish.result.getString("name"));
  Doc folder=docs.values().stream().filter(x->"Foto (parziale)".equals(x.name))
      .findFirst().orElseThrow();
  Doc saved=docs.values().stream().filter(x->"one.bin".equals(x.name))
      .findFirst().orElseThrow();
  assertEquals(folder.id,saved.parent);
  assertArrayEquals(new byte[]{1,2,3},Files.readAllBytes(saved.bytes.toPath()));
  assertFalse(docs.values().stream().anyMatch(x->"two.bin".equals(x.name)));
 }
