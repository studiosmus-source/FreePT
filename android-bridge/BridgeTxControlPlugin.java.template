package __PACKAGE__;

import android.content.Intent;
import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.CapacitorPlugin;

/** Explicit native bridge foreground controls. Backend still checks grants. */
@CapacitorPlugin(name="BridgeTxControl")
public class BridgeTxControlPlugin extends Plugin {
    @PluginMethod public void status(PluginCall call){
        JSObject out=new JSObject();
        out.put("running",BridgeTxService.active);
        out.put("permissionGranted",BridgeAllFilesCore.granted());
        out.put("configured",BridgeDeviceSecretStore.configured(getContext()));
        out.put("paused",getContext().getSharedPreferences("freept_tx_control",0)
            .getBoolean("paused",false));
        call.resolve(out);
    }
    @PluginMethod public void start(PluginCall call){
        if(!BridgeAllFilesCore.granted()||
           !BridgeDeviceSecretStore.configured(getContext())){
            call.reject("bridge_tx_permission_or_device_missing");return;
        }
        // Android does not require POST_NOTIFICATIONS to start a foreground
        // service. Chat push permission is handled independently by Capacitor.
        performStart(call);
    }
    private void performStart(PluginCall call){
        try{
            getContext().getSharedPreferences("freept_tx_control",0)
                .edit().putBoolean("paused",false).commit();
            Intent intent=new Intent(getContext(),BridgeTxService.class);
            androidx.core.content.ContextCompat.startForegroundService(getContext(),intent);
            JSObject out=new JSObject();out.put("requested",true);call.resolve(out);
        }catch(Exception error){call.reject("bridge_tx_cannot_start");}
    }
    @PluginMethod public void stop(PluginCall call){
        getContext().getSharedPreferences("freept_tx_control",0)
            .edit().putBoolean("paused",true).apply();
        getContext().stopService(new Intent(getContext(),BridgeTxService.class));
        JSObject out=new JSObject();out.put("requested",true);call.resolve(out);
    }
}
