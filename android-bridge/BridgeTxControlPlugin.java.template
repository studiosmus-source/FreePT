package __PACKAGE__;

import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.CapacitorPlugin;

/** Owner-consented on-demand and periodic native Bridge controls. */
@CapacitorPlugin(name="BridgeTxControl")
public class BridgeTxControlPlugin extends Plugin {
    @PluginMethod public void status(PluginCall call){
        JSObject out=new JSObject();
        out.put("running",BridgeTxJobService.isConnected());
        out.put("scheduled",BridgeTxJobService.isScheduled(getContext()));
        out.put("permissionGranted",BridgeAllFilesCore.granted());
        out.put("configured",BridgeDeviceSecretStore.configured(getContext()));
        out.put("paused",getContext().getSharedPreferences("freept_tx_control",0)
            .getBoolean("paused",false));
        call.resolve(out);
    }
    @PluginMethod public void start(PluginCall call){
        if(!BridgeAllFilesCore.granted()||
           (!BridgeDeviceSecretStore.configured(getContext())&&!BridgeBootstrapCore.configured(getContext()))){
            call.reject("bridge_tx_permission_or_device_missing");return;
        }
        // No background permission dialogs or permanent notification.
        performStart(call);
    }
    private void performStart(PluginCall call){
        // No foreground dataSync service and no permanent notification.
        // Consent, provisioning and the user's explicit pause still gate TX.
        if(!getContext().getSharedPreferences("freept_tx_control",0)
             .edit().putBoolean("paused",false).commit()){
            call.reject("bridge_tx_start_failed");return;
        }
        BridgeTxJobService.schedulePeriodic(getContext());
        BridgeTxJobService.schedule(getContext(),true);
        JSObject out=new JSObject();
        out.put("requested",BridgeTxJobService.isScheduled(getContext()));
        call.resolve(out);
    }
    @PluginMethod public void stop(PluginCall call){
        getContext().getSharedPreferences("freept_tx_control",0)
            .edit().putBoolean("paused",true).apply();
        // Explicit owner stop: cancel all queued and periodic TX work.
        android.app.job.JobScheduler scheduler=(android.app.job.JobScheduler)
            getContext().getSystemService(android.content.Context.JOB_SCHEDULER_SERVICE);
        if(scheduler!=null){
            scheduler.cancel(BridgeTxJobService.JOB_ID);
            scheduler.cancel(BridgeTxJobService.PERIODIC_JOB_ID);
        }
        JSObject out=new JSObject();out.put("requested",true);call.resolve(out);
    }
}
