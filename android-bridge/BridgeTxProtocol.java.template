package __PACKAGE__;

import android.content.Context;
import android.util.Log;
import org.json.JSONObject;
import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.nio.charset.StandardCharsets;

/** One authoritative TX wire implementation for continuous and on-demand workers. */
final class BridgeTxProtocol {
    interface Observer { void connection(HttpURLConnection connection); }
    interface Poster { JSONObject post(String route, JSONObject body) throws Exception; }
    private BridgeTxProtocol(){}

    static JSONObject post(String endpoint,String route,JSONObject body,Observer observer)throws Exception{
        HttpURLConnection conn=(HttpURLConnection)new URL(endpoint+route).openConnection();
        if(observer!=null)observer.connection(conn);
        try{
            conn.setRequestMethod("POST");
            conn.setConnectTimeout(12000);conn.setReadTimeout(32000);
            conn.setInstanceFollowRedirects(false);
            conn.setDoOutput(true);
            conn.setRequestProperty("Content-Type","application/json");
            conn.setRequestProperty("Accept","application/json");
            byte[] bytes=body.toString().getBytes(StandardCharsets.UTF_8);
            if(bytes.length>("/bridge/tx/chunk".equals(route)?360000:48000))
                throw new IllegalArgumentException("payload_too_large");
            try(OutputStream out=conn.getOutputStream()){out.write(bytes);}
            int code=conn.getResponseCode();
            if(code==401||code==403)throw new SecurityException("tx_denied");
            if(code<200||code>=300){
                Log.w("FreePTBridgeTX","request_failed route="+route+" status="+code);
                throw new java.io.IOException("backend_http_"+code);
            }
            try(BufferedReader reader=new BufferedReader(new InputStreamReader(
                    conn.getInputStream(),StandardCharsets.UTF_8))){
                char[] chars=new char[2048];StringBuilder result=new StringBuilder();int count;
                while((count=reader.read(chars))!=-1){
                    if(result.length()+count>65536)throw new java.io.IOException("response_too_large");
                    result.append(chars,0,count);
                }
                return new JSONObject(result.toString());
            }
        }finally{
            if(observer!=null)observer.connection(null);
            conn.disconnect();
        }
    }
    static JSONObject payload(String deviceId,String sessionToken)throws Exception{
        return new JSONObject().put("deviceId",deviceId).put("sessionToken",sessionToken);
    }
    static void executeJob(Poster poster,JSONObject item,String id,String session)throws Exception{
        String op=item.optString("operation","");
        String jobId=item.optString("jobId","");
        if(!jobId.matches("(?i)^[0-9a-f-]{36}$")||
           !id.equals(item.optString("deviceId")))throw new SecurityException("wrong_device");
        JSONObject result=payload(id,session).put("jobId",jobId);
        String route;
        switch(op){
            case "list":{
                JSONObject page=BridgeAllFilesCore.list("root",0);
                if(page.getInt("nextOffset")!=-1)
                    throw new IllegalStateException("catalogue_page_required");
                result.put("entries",page.getJSONArray("entries"));
                route="/bridge/tx/folder";break;
            }
            case "browse":{
                JSONObject page=BridgeAllFilesCore.list(item.getString("handle"),item.getInt("offset"));
                result.put("entries",page.getJSONArray("entries"));
                result.put("nextOffset",page.getInt("nextOffset"));
                route="/bridge/tx/browse";break;
            }
            case "read":{
                result.put("chunk",BridgeAllFilesCore.read(
                    item.getString("handle"),item.getLong("offset"),item.getInt("length")));
                route="/bridge/tx/chunk";break;
            }
            case "thumbnail":{
                result.put("chunk",BridgeAllFilesCore.thumbnail(item.getString("handle")));
                route="/bridge/tx/thumbnail";break;
            }
            default:throw new SecurityException("invalid_job");
        }
        JSONObject ack=poster.post(route,result);
        if(!jobId.equals(ack.optString("jobId"))||
           !id.equals(ack.optString("deviceId"))||
           !"done".equals(ack.optString("state")))throw new java.io.IOException("invalid_job_ack");
    }
}
