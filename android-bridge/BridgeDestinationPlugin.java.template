package __PACKAGE__;

import android.app.Activity;
import android.content.Intent;
import android.database.Cursor;
import android.net.Uri;
import android.os.ParcelFileDescriptor;
import android.provider.DocumentsContract;
import android.util.Base64;
import androidx.activity.result.ActivityResult;
import com.getcapacitor.JSArray;
import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.ActivityCallback;
import com.getcapacitor.annotation.CapacitorPlugin;
import java.io.FileOutputStream;
import java.nio.ByteBuffer;
import java.nio.channels.FileChannel;
import java.util.HashMap;
import java.util.Map;
import java.util.UUID;

/**
 * Receiver-side staging destination. Writes ONLY beneath the folder explicitly
 * chosen via ACTION_OPEN_DOCUMENT_TREE. No broad storage permissions.
 * A transfer is exposed by SAF rename only after all files have completed.
 * A provider that does not support rename fails closed.
 */
@CapacitorPlugin(name = "BridgeDestination")
public class BridgeDestinationPlugin extends Plugin {
    private static final String PREFS="freept_bridge_destination";
    private static final String SELECTED="selected_tree";
    private static final long MAX_FILE_BYTES=1099511627776L;
    private static final int MAX_CHUNK=32768;
    private Uri destination;
    private Uri staging;
    private String finalName;
    private final Map<String,Uri> directories=new HashMap<>();
    private final Map<String,FileEntry> files=new HashMap<>();

    private static final class FileEntry {
        final Uri uri;
        final long expected;
        long written=0;
        boolean completed=false;
        FileEntry(Uri uri,long expected){this.uri=uri;this.expected=expected;}
    }

    private boolean validName(String name){
        return name!=null&&name.length()>=1&&name.length()<=255&&
            !name.equals(".")&&!name.equals("..")&&
            !name.matches(".*[\\\\/\\p{Cntrl}].*");
    }

    private String[] path(PluginCall call){
        JSArray array=call.getArray("path");
        if(array==null||array.length()<1||array.length()>16)
            throw new IllegalArgumentException("bridge_destination_invalid_path");
        String[] names=new String[array.length()];
        for(int i=0;i<array.length();i++){
            Object item=array.opt(i);
            if(!(item instanceof String)||!validName((String)item))
                throw new IllegalArgumentException("bridge_destination_invalid_path");
            names[i]=(String)item;
        }
        return names;
    }

    private static String key(String[] names,int length){
        StringBuilder builder=new StringBuilder();
        for(int i=0;i<length;i++){
            if(i>0)builder.append('/');
            builder.append(names[i]);
        }
        return builder.toString();
    }

    private void restore(){
        if(destination!=null)return;
        String saved=getContext().getSharedPreferences(PREFS,0).getString(SELECTED,null);
        if(saved==null)return;
        Uri uri=Uri.parse(saved);
        for(android.content.UriPermission permission:
                getContext().getContentResolver().getPersistedUriPermissions()){
            if(permission.getUri().equals(uri)&&permission.isWritePermission()){
                destination=DocumentsContract.buildDocumentUriUsingTree(
                    uri,DocumentsContract.getTreeDocumentId(uri));
                return;
            }
        }
        getContext().getSharedPreferences(PREFS,0).edit().remove(SELECTED).apply();
    }

    @PluginMethod
    public void getDestination(PluginCall call){
        restore();
        JSObject result=new JSObject();
        result.put("selected",destination!=null);
        call.resolve(result);
    }

    @PluginMethod
    public void chooseDestination(PluginCall call){
        if(staging!=null){call.reject("bridge_destination_busy");return;}
        Intent intent=new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION|
            Intent.FLAG_GRANT_WRITE_URI_PERMISSION|
            Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
        startActivityForResult(call,intent,"chosen");
    }

    @ActivityCallback
    private void chosen(PluginCall call,ActivityResult result){
        if(call==null)return;
        Intent data=result.getData();
        if(result.getResultCode()!=Activity.RESULT_OK||data==null||
            data.getData()==null){
            call.reject("bridge_destination_cancelled");return;
        }
        Uri uri=data.getData();
        try{
            getContext().getContentResolver().takePersistableUriPermission(
                uri,Intent.FLAG_GRANT_READ_URI_PERMISSION|
                    Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
            destination=DocumentsContract.buildDocumentUriUsingTree(
                uri,DocumentsContract.getTreeDocumentId(uri));
            if(!getContext().getSharedPreferences(PREFS,0).edit()
                .putString(SELECTED,uri.toString()).commit())
                throw new IllegalStateException();
            JSObject reply=new JSObject();reply.put("selected",true);
            call.resolve(reply);
        }catch(Exception error){call.reject("bridge_destination_permission_denied");}
    }

    @PluginMethod
    public void beginFolder(PluginCall call){
        restore();
        String name=call.getString("name");
        if(destination==null||staging!=null||!validName(name)){
            call.reject("bridge_destination_not_ready");return;
        }
        try{
            Uri temp=DocumentsContract.createDocument(
                getContext().getContentResolver(),destination,
                DocumentsContract.Document.MIME_TYPE_DIR,
                ".freept-partial-"+UUID.randomUUID());
            if(temp==null)throw new IllegalStateException();
            staging=temp;finalName=name;
            directories.clear();directories.put("",temp);files.clear();
            JSObject result=new JSObject();result.put("started",true);
            call.resolve(result);
        }catch(Exception error){call.reject("bridge_destination_create_failed");}
    }

    @PluginMethod
    public void makeDirectory(PluginCall call){
        if(staging==null){call.reject("bridge_destination_not_started");return;}
        try{
            String[] names=path(call);
            String target=key(names,names.length);
            if(directories.containsKey(target)){
                call.reject("bridge_destination_duplicate_path");return;
            }
            Uri parent=directories.get(key(names,names.length-1));
            if(parent==null)throw new IllegalArgumentException();
            Uri created=DocumentsContract.createDocument(
                getContext().getContentResolver(),parent,
                DocumentsContract.Document.MIME_TYPE_DIR,names[names.length-1]);
            if(created==null)throw new IllegalStateException();
            directories.put(target,created);
            call.resolve();
        }catch(Exception error){call.reject("bridge_destination_mkdir_failed");}
    }

    @PluginMethod
    public void openFile(PluginCall call){
        if(staging==null){call.reject("bridge_destination_not_started");return;}
        try{
            String[] names=path(call);
            Object raw=call.getData().opt("size");
            if(!(raw instanceof Number))throw new IllegalArgumentException();
            long size=((Number)raw).longValue();
            if(((Number)raw).doubleValue()!=(double)size||
                size<0||size>MAX_FILE_BYTES)throw new IllegalArgumentException();
            String mime=call.getString("mime","application/octet-stream");
            if(mime==null||mime.length()>160)throw new IllegalArgumentException();
            Uri parent=directories.get(key(names,names.length-1));
            if(parent==null)throw new IllegalArgumentException();
            Uri created=DocumentsContract.createDocument(
                getContext().getContentResolver(),parent,
                mime.isEmpty()?"application/octet-stream":mime,
                names[names.length-1]);
            if(created==null)throw new IllegalStateException();
            String id=UUID.randomUUID().toString();
            files.put(id,new FileEntry(created,size));
            JSObject result=new JSObject();result.put("fileId",id);
            call.resolve(result);
        }catch(Exception error){call.reject("bridge_destination_file_failed");}
    }

    @PluginMethod
    public void writeChunk(PluginCall call){
        FileEntry file=files.get(call.getString("fileId"));
        Object raw=call.getData().opt("offset");
        String encoded=call.getString("base64");
        if(staging==null||file==null||file.completed||
            !(raw instanceof Number)||encoded==null||
            encoded.length()>43692){
            call.reject("bridge_destination_write_invalid");return;
        }
        long offset=((Number)raw).longValue();
        if(((Number)raw).doubleValue()!=(double)offset||offset!=file.written){
            call.reject("bridge_destination_write_out_of_order");return;
        }
        try{
            byte[] bytes=Base64.decode(encoded,Base64.NO_WRAP);
            if(bytes.length<1||bytes.length>MAX_CHUNK||
                file.written>file.expected-bytes.length)
                throw new IllegalArgumentException();
            try(ParcelFileDescriptor fd=getContext().getContentResolver()
                    .openFileDescriptor(file.uri,"rw")){
                if(fd==null)throw new IllegalStateException();
                try(FileOutputStream out=new FileOutputStream(fd.getFileDescriptor())){
                    FileChannel channel=out.getChannel();
                    channel.position(offset);
                    ByteBuffer input=ByteBuffer.wrap(bytes);
                    while(input.hasRemaining())channel.write(input);
                }
            }
            file.written+=bytes.length;
            JSObject result=new JSObject();result.put("written",file.written);
            call.resolve(result);
        }catch(Exception error){call.reject("bridge_destination_write_failed");}
    }

    @PluginMethod
    public void commitFile(PluginCall call){
        FileEntry file=files.get(call.getString("fileId"));
        if(staging==null||file==null||file.completed||
            file.written!=file.expected){
            call.reject("bridge_destination_file_incomplete");return;
        }
        file.completed=true;
        call.resolve();
    }

    @PluginMethod
    public void discardFile(PluginCall call){
        String id=call.getString("fileId");
        FileEntry file=files.get(id);
        if(staging==null||file==null){call.reject("bridge_destination_file_missing");return;}
        try{
            if(!DocumentsContract.deleteDocument(
                getContext().getContentResolver(),file.uri))
                throw new IllegalStateException();
            files.remove(id);
            call.resolve();
        }catch(Exception error){call.reject("bridge_destination_file_cleanup_failed");}
    }

    @PluginMethod
    public void commitFolder(PluginCall call){
        if(staging==null){call.reject("bridge_destination_not_started");return;}
        for(FileEntry file:files.values()){
            if(!file.completed){call.reject("bridge_destination_files_incomplete");return;}
        }
        try{
            Uri renamed=DocumentsContract.renameDocument(
                getContext().getContentResolver(),staging,finalName);
            if(renamed==null)throw new IllegalStateException();
            // SAF providers may rewrite the requested name: fail rather than
            // claiming that an arbitrary destination was correctly named.
            try(Cursor c=getContext().getContentResolver().query(renamed,
                new String[]{DocumentsContract.Document.COLUMN_DISPLAY_NAME},
                null,null,null)){
                if(c==null||!c.moveToFirst()||!finalName.equals(c.getString(0)))
                    throw new IllegalStateException();
            }
            staging=null;finalName=null;
            directories.clear();files.clear();
            call.resolve();
        }catch(Exception error){call.reject("bridge_destination_commit_failed");}
    }

    @PluginMethod
    public void discardFolder(PluginCall call){
        if(staging==null){call.resolve();return;}
        try{
            if(!DocumentsContract.deleteDocument(getContext().getContentResolver(),staging))
                throw new IllegalStateException();
            staging=null;finalName=null;
            directories.clear();files.clear();
            call.resolve();
        }catch(Exception error){call.reject("bridge_destination_cleanup_failed");}
    }

    @PluginMethod
    public void clearDestination(PluginCall call){
        if(staging!=null){call.reject("bridge_destination_busy");return;}
        destination=null;
        if(!getContext().getSharedPreferences(PREFS,0).edit()
            .remove(SELECTED).commit()){
            call.reject("bridge_destination_clear_failed");return;
        }
        call.resolve();
    }
}
