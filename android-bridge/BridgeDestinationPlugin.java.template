/**
 * Receiver-side staging destination. Writes ONLY beneath the folder explicitly
 * chosen via ACTION_OPEN_DOCUMENT_TREE. No broad storage permissions.
 * A transfer is exposed by SAF rename only after all files have completed.
 * A provider that does not support rename fails closed.
 */
@CapacitorPlugin(name = "BridgeDestination")
public class BridgeDestinationPlugin extends Plugin {
    /**
     * RX only: render bounded PDF bytes locally, never a remote path/URL.
     * PdfRenderer does not execute PDF JavaScript or open external links.
     * Temporary input lives in the app-private cache and is removed on exit.
     */
    @PluginMethod public synchronized void renderPdfPreview(PluginCall call){
        String encoded=call.getString("base64");
        Integer pageIndex=call.getInt("page",0);
        if(encoded==null||encoded.length()>2796204||pageIndex==null||pageIndex<0||
           !encoded.matches("[A-Za-z0-9+/]*={0,2}")){
            call.reject("bridge_pdf_invalid");return;
        }
        File input=null;
        Bitmap bitmap=null;
        try{
            byte[] bytes=Base64.decode(encoded,Base64.NO_WRAP);
            if(bytes.length<5||bytes.length>2097152||
               bytes[0]!='%'||bytes[1]!='P'||bytes[2]!='D'||bytes[3]!='F'||bytes[4]!='-')
                throw new IllegalArgumentException("pdf");
            input=File.createTempFile("freept-preview-",".pdf",getContext().getCacheDir());
            try(FileOutputStream out=new FileOutputStream(input)){out.write(bytes);}
            try(ParcelFileDescriptor fd=ParcelFileDescriptor.open(input,ParcelFileDescriptor.MODE_READ_ONLY);
                PdfRenderer renderer=new PdfRenderer(fd)){
                int count=renderer.getPageCount();
                if(pageIndex>=count)throw new IllegalArgumentException("page");
                try(PdfRenderer.Page page=renderer.openPage(pageIndex)){
                    float scale=Math.min(1440f/page.getWidth(),2048f/page.getHeight());
                    int width=Math.max(1,Math.round(page.getWidth()*scale));
                    int height=Math.max(1,Math.round(page.getHeight()*scale));
                    bitmap=Bitmap.createBitmap(width,height,Bitmap.Config.ARGB_8888);
                    bitmap.eraseColor(Color.WHITE);
                    page.render(bitmap,null,null,PdfRenderer.Page.RENDER_MODE_FOR_DISPLAY);
                    ByteArrayOutputStream png=new ByteArrayOutputStream();
                    if(!bitmap.compress(Bitmap.CompressFormat.PNG,100,png))
                        throw new IllegalStateException("render");
                    JSObject result=new JSObject();
                    result.put("base64",Base64.encodeToString(png.toByteArray(),Base64.NO_WRAP));
                    result.put("pageCount",count);
                    call.resolve(result);
                }
            }
        }catch(Exception error){
            call.reject("bridge_pdf_unavailable");
        }finally{
            if(bitmap!=null)bitmap.recycle();
            if(input!=null)input.delete();
        }
    }
    private static final String PREFS="freept_bridge_destination";
    private static final String SELECTED="selected_tree";
    private static final long MAX_FILE_BYTES=1099511627776L;
    private static final int MAX_CHUNK=262144;
    private boolean choosing=false;
    private Uri destination;
    private Uri transferParent;
    private Uri staging;
    private String finalName;
    private Uri singleStaging;
    private String singleName;
    private final Map<String,Uri> directories=new HashMap<>();
    private final Map<String,FileEntry> files=new HashMap<>();

    private static final class FileEntry {
        Uri uri;
        final long expected;
        long written=0;
        boolean completed=false;
        // Folder transfers: each file is written under a hidden temporary
        // name and renamed to finalName inside parentDir once verified, so a
        // file with its real name is always complete (also after a crash).
        final Uri parentDir;
        final String finalName;
        FileEntry(Uri uri,long expected){this(uri,expected,null,null);}
        FileEntry(Uri uri,long expected,Uri parentDir,String finalName){
            this.uri=uri;this.expected=expected;this.parentDir=parentDir;this.finalName=finalName;
        }
    }
    private final java.util.Set<String> openedPaths=new java.util.HashSet<>();

    /** Name check inside an arbitrary directory of the selected tree. */
    private boolean nameTakenIn(Uri dir,String requested) throws Exception {
        Uri children=DocumentsContract.buildChildDocumentsUriUsingTree(dir,DocumentsContract.getDocumentId(dir));
        String wanted=java.text.Normalizer.normalize(requested,java.text.Normalizer.Form.NFC);
        try(Cursor cursor=getContext().getContentResolver().query(children,
            new String[]{DocumentsContract.Document.COLUMN_DISPLAY_NAME},null,null,null)){
            if(cursor==null)throw new IllegalStateException("bridge_destination_unreadable");
            while(cursor.moveToNext()){
                String found=cursor.getString(0);
                if(found!=null&&java.text.Normalizer.normalize(found,java.text.Normalizer.Form.NFC)
                    .equalsIgnoreCase(wanted))return true;
            }
        }
        return false;
    }
    private String freeNameIn(Uri dir,String requested) throws Exception {
        if(!validName(requested))throw new IllegalArgumentException("bridge_destination_invalid_target");
        if(!nameTakenIn(dir,requested))return requested;
        for(int index=2;index<=999;index++){
            String suffix=" ("+index+")";
            String candidate=requested.substring(0,Math.min(requested.length(),255-suffix.length()))+suffix;
            if(validName(candidate)&&!nameTakenIn(dir,candidate))return candidate;
        }
        throw new IllegalStateException("bridge_destination_no_free_name");
    }
    private static String withSuffix(String base,String suffix){
        return base.substring(0,Math.min(base.length(),255-suffix.length()))+suffix;
    }

    private boolean validName(String name){
        return name!=null&&name.length()>=1&&name.length()<=255&&
            !name.equals(".")&&!name.equals("..")&&
            !name.matches("(?s).*[\\\\/\\p{Cntrl}].*");
    }

    /**
     * Fail closed if a target name already exists in the explicitly selected
     * destination. Also checks again immediately before final rename.
     * SAF rename semantics vary by provider and must never silently overwrite.
     */
    private boolean targetExists(String requestedName) throws Exception {
        if(destination==null||!validName(requestedName))
            throw new IllegalArgumentException("bridge_destination_invalid_target");
        Uri children=DocumentsContract.buildChildDocumentsUriUsingTree(
            parent(),DocumentsContract.getDocumentId(parent()));
        try(Cursor cursor=getContext().getContentResolver().query(
            children,new String[]{DocumentsContract.Document.COLUMN_DISPLAY_NAME},
            null,null,null)){
            if(cursor==null)throw new IllegalStateException("bridge_destination_unreadable");
            String wanted=java.text.Normalizer.normalize(requestedName,
                java.text.Normalizer.Form.NFC);
            while(cursor.moveToNext()){
                String found=cursor.getString(0);
                if(found!=null&&java.text.Normalizer.normalize(found,
                    java.text.Normalizer.Form.NFC).equalsIgnoreCase(wanted))
                    return true;
            }
            return false;
        }
    }

    /** Pick a free name without overwriting an existing user document. */
    private String availableName(String requestedName) throws Exception {
        if(!validName(requestedName))
            throw new IllegalArgumentException("bridge_destination_invalid_target");
        if(!targetExists(requestedName))return requestedName;
        int dot=requestedName.lastIndexOf('.');
        String stem=dot>0?requestedName.substring(0,dot):requestedName;
        String ext=dot>0?requestedName.substring(dot):"";
        for(int index=1;index<=999;index++){
            String suffix=" ("+index+")";
            int allowed=255-ext.length()-suffix.length();
            if(allowed<1)break;
            String candidate=stem.substring(0,Math.min(stem.length(),allowed))+suffix+ext;
            if(validName(candidate)&&!targetExists(candidate))return candidate;
        }
        throw new IllegalStateException("bridge_destination_no_free_name");
    }

    private Uri parent(){return transferParent==null?destination:transferParent;}

    private boolean documentMatches(Uri uri,String mime,Long size) throws Exception {
        try(Cursor c=getContext().getContentResolver().query(uri,
            new String[]{DocumentsContract.Document.COLUMN_MIME_TYPE,DocumentsContract.Document.COLUMN_SIZE},null,null,null)){
            if(c==null)throw new IllegalStateException("bridge_destination_provider_unavailable");
            return c.moveToFirst()&&(mime==null||mime.equals(c.getString(0)))&&
                (size==null||(!c.isNull(1)&&c.getLong(1)==size));
        }
    }

    /**
     * SAF document providers may append a MIME extension to a newly created
     * file. Include that extension on hidden staging files from the start,
     * while retaining the strict createFresh identity/name/MIME checks.
     */
    private String temporaryFileName(String finalFileName,String mime){
        String suffix="";
        if(!"application/octet-stream".equals(mime)&&!mime.isEmpty()){
            String inferred=android.webkit.MimeTypeMap.getSingleton()
                .getExtensionFromMimeType(mime);
            if(inferred!=null&&inferred.matches("[A-Za-z0-9]{1,12}"))
                suffix="."+inferred;
            else{
                int dot=finalFileName.lastIndexOf('.');
                if(dot>=0&&dot<finalFileName.length()-1){
                    String candidate=finalFileName.substring(dot);
                    if(candidate.matches("\\.[A-Za-z0-9]{1,12}"))
                        suffix=candidate;
                }
            }
        }
        return ".freept-partial-"+UUID.randomUUID()+suffix;
    }

    /** Never write to an existing document returned by a broken provider. */
    private Uri createFresh(Uri parent,String mime,String requested) throws Exception {
        java.util.Set<String> ids=new java.util.HashSet<>();
        Uri children=DocumentsContract.buildChildDocumentsUriUsingTree(parent,DocumentsContract.getDocumentId(parent));
        try(Cursor c=getContext().getContentResolver().query(children,
            new String[]{DocumentsContract.Document.COLUMN_DOCUMENT_ID,DocumentsContract.Document.COLUMN_DISPLAY_NAME},null,null,null)){
            if(c==null)throw new IllegalStateException("bridge_destination_unreadable");
            while(c.moveToNext()){
                ids.add(c.getString(0));
                if(c.getString(1)!=null&&BridgeDestinationNames.folded(c.getString(1)).equals(BridgeDestinationNames.folded(requested)))
                    throw new IllegalStateException("bridge_destination_exists");
            }
        }
        Uri made=DocumentsContract.createDocument(getContext().getContentResolver(),parent,mime,requested);
        if(made==null||DocumentsContract.getDocumentId(parent).equals(DocumentsContract.getDocumentId(made))||ids.contains(DocumentsContract.getDocumentId(made)))
            throw new IllegalStateException("bridge_destination_existing_document_returned");
        try(Cursor c=getContext().getContentResolver().query(made,
            new String[]{DocumentsContract.Document.COLUMN_DISPLAY_NAME,DocumentsContract.Document.COLUMN_MIME_TYPE},null,null,null)){
            if(c==null||!c.moveToFirst()||!requested.equals(c.getString(0))||!mime.equals(c.getString(1))){
                DocumentsContract.deleteDocument(getContext().getContentResolver(),made);
                throw new IllegalStateException("bridge_destination_provider_renamed");
            }
        }
        return made;
    }

    private Uri ownerDirectory(PluginCall call) throws Exception {
        String ownerId=call.getString("ownerId");
        if(ownerId==null)return destination; // Preserve the existing non-admin writer.
        if(!ownerId.matches("(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"))
            throw new IllegalArgumentException("bridge_destination_invalid_owner");
        String root=DocumentsContract.getDocumentId(destination);
        String mapping="owner:"+destination.toString()+":"+ownerId.toLowerCase(java.util.Locale.ROOT);
        android.content.SharedPreferences prefs=getContext().getSharedPreferences(PREFS,0);
        String saved=prefs.getString(mapping,null);
        Uri children=DocumentsContract.buildChildDocumentsUriUsingTree(destination,root);
        java.util.Set<String> names=new java.util.HashSet<>();
        try(Cursor c=getContext().getContentResolver().query(children,
            new String[]{DocumentsContract.Document.COLUMN_DOCUMENT_ID,DocumentsContract.Document.COLUMN_DISPLAY_NAME,
                DocumentsContract.Document.COLUMN_MIME_TYPE},null,null,null)){
            if(c==null)throw new IllegalStateException("bridge_destination_unreadable");
            while(c.moveToNext()){
                if(saved!=null&&saved.equals(c.getString(0))&&
                    DocumentsContract.Document.MIME_TYPE_DIR.equals(c.getString(2)))
                    return DocumentsContract.buildDocumentUriUsingTree(destination,saved);
                String n=c.getString(1);
                if(n!=null)names.add(java.text.Normalizer.normalize(n,java.text.Normalizer.Form.NFC).toLowerCase(java.util.Locale.ROOT));
            }
        }
        // Never adopt an existing directory merely because its name matches.
        String candidate=BridgeDestinationNames.ownerName(call.getString("ownerName","Persona"),names);
        Uri created=createFresh(destination,
            DocumentsContract.Document.MIME_TYPE_DIR,candidate);
        if(created==null||!documentMatches(created,DocumentsContract.Document.MIME_TYPE_DIR,null))
            throw new IllegalStateException("bridge_destination_owner_failed");
        if(!prefs.edit().putString(mapping,DocumentsContract.getDocumentId(created)).commit()){
            DocumentsContract.deleteDocument(getContext().getContentResolver(),created);
            throw new IllegalStateException("bridge_destination_owner_persistence_failed");
        }
        return created;
    }

    private String[] path(PluginCall call){
        JSArray array=call.getArray("path");
        if(array==null||array.length()<1||array.length()>32)
            throw new IllegalArgumentException("bridge_destination_invalid_path");
        String[] names=new String[array.length()];
        for(int i=0;i<array.length();i++){
            Object item=array.opt(i);
            if(!(item instanceof String)||!validName((String)item))
                throw new IllegalArgumentException("bridge_destination_invalid_path");
            names[i]=(String)item;
        }
        return names;
    }

    private static String key(String[] names,int length){
        StringBuilder builder=new StringBuilder();
        for(int i=0;i<length;i++){
            if(i>0)builder.append('/');
            builder.append(names[i]);
        }
        return builder.toString();
    }

    private boolean recoveryBlocked=false;
    private void journal(Uri uri) throws Exception {journal(uri,null,true);}
    private void journal(Uri uri,String finalLabel,boolean published) throws Exception {
        org.json.JSONObject value=new org.json.JSONObject();
        if(finalLabel!=null)value.put("final",finalLabel);
        value.put("published",published);
        value.put("tree",getContext().getSharedPreferences(PREFS,0).getString(SELECTED,null));
        value.put("parent",DocumentsContract.getDocumentId(parent()));
        value.put("document",DocumentsContract.getDocumentId(uri));
        try(Cursor c=getContext().getContentResolver().query(uri,
            new String[]{DocumentsContract.Document.COLUMN_DISPLAY_NAME},null,null,null)){
            if(c==null||!c.moveToFirst())throw new IllegalStateException();
            value.put("name",c.getString(0));
        }
        if(!getContext().getSharedPreferences(PREFS,0).edit().putString("pending_stage",value.toString()).commit())
            throw new IllegalStateException("bridge_destination_journal_failed");
    }
    private void forgetJournal() throws Exception {
        if(!getContext().getSharedPreferences(PREFS,0).edit().remove("pending_stage").commit())
            throw new IllegalStateException("bridge_destination_journal_failed");
    }
    private void recoverPending(){
        recoveryBlocked=false;
        if(staging!=null||singleStaging!=null)return;
        String raw=getContext().getSharedPreferences(PREFS,0).getString("pending_stage",null);
        if(raw==null)return;
        try{
            org.json.JSONObject j=new org.json.JSONObject(raw);
            if(!j.getString("tree").equals(getContext().getSharedPreferences(PREFS,0).getString(SELECTED,null)))
                throw new IllegalStateException();
            Uri p=DocumentsContract.buildDocumentUriUsingTree(destination,j.getString("parent"));
            Uri children=DocumentsContract.buildChildDocumentsUriUsingTree(p,j.getString("parent"));
            String foundMime=null;Uri owned=null;
            try(Cursor c=getContext().getContentResolver().query(children,
                new String[]{DocumentsContract.Document.COLUMN_DOCUMENT_ID,DocumentsContract.Document.COLUMN_DISPLAY_NAME,
                    DocumentsContract.Document.COLUMN_MIME_TYPE},null,null,null)){
                if(c==null)throw new IllegalStateException();
                while(c.moveToNext())if(j.getString("document").equals(c.getString(0))){
                    if(!j.getString("name").equals(c.getString(1)))throw new IllegalStateException();
                    owned=DocumentsContract.buildDocumentUriUsingTree(destination,c.getString(0));
                    foundMime=c.getString(2);
                    break;
                }
            }
            // Old journals (2.9.1) carry no "published" flag: treat as staging.
            boolean published=j.optBoolean("published",false);
            if(owned!=null&&!published){
                if(DocumentsContract.Document.MIME_TYPE_DIR.equals(foundMime)){
                    // Interrupted folder: drop only unfinished hidden files and
                    // publish every verified file as "<name> (interrotto)".
                    int kept=keepCompletedOnly(owned,0);
                    if(kept>0){
                        String target=freeNameIn(p,withSuffix(j.optString("final","Download"),INTERRUPTED));
                        Uri renamed=DocumentsContract.renameDocument(getContext().getContentResolver(),owned,target);
                        if(renamed==null)throw new IllegalStateException();
                        getContext().getSharedPreferences(PREFS,0).edit()
                            .putString("recovered_name",target).putInt("recovered_files",kept)
                            // Before 2.9.3 files were written under their real name:
                            // the last one may be truncated. Say so to the user.
                            .putBoolean("recovered_legacy",!j.has("published")).commit();
                    }else if(!DocumentsContract.deleteDocument(getContext().getContentResolver(),owned))
                        throw new IllegalStateException();
                }else if(!DocumentsContract.deleteDocument(getContext().getContentResolver(),owned))
                    throw new IllegalStateException(); // a single unfinished file
            }
            forgetJournal();
        }catch(Exception error){recoveryBlocked=true;}
    }

    private static final String INTERRUPTED=" (interrotto)";
    /** Deletes unfinished hidden files below dir; returns completed files kept. */
    private int keepCompletedOnly(Uri dir,int depth) throws Exception {
        if(depth>40)throw new IllegalStateException("bridge_destination_depth");
        java.util.List<String[]> rows=new java.util.ArrayList<>();
        Uri children=DocumentsContract.buildChildDocumentsUriUsingTree(dir,DocumentsContract.getDocumentId(dir));
        try(Cursor c=getContext().getContentResolver().query(children,
            new String[]{DocumentsContract.Document.COLUMN_DOCUMENT_ID,DocumentsContract.Document.COLUMN_DISPLAY_NAME,
                DocumentsContract.Document.COLUMN_MIME_TYPE},null,null,null)){
            if(c==null)throw new IllegalStateException("bridge_destination_unreadable");
            while(c.moveToNext())rows.add(new String[]{c.getString(0),c.getString(1),c.getString(2)});
        }
        int kept=0;
        for(String[] row:rows){
            Uri child=DocumentsContract.buildDocumentUriUsingTree(destination,row[0]);
            if(DocumentsContract.Document.MIME_TYPE_DIR.equals(row[2]))kept+=keepCompletedOnly(child,depth+1);
            else if(row[1]!=null&&row[1].startsWith(".freept-partial-")){
                if(!DocumentsContract.deleteDocument(getContext().getContentResolver(),child))
                    throw new IllegalStateException();
            }else kept++;
        }
        return kept;
    }

    private void restore(){
        destination=null;
        String saved=getContext().getSharedPreferences(PREFS,0).getString(SELECTED,null);
        if(saved==null)return;
        Uri uri=Uri.parse(saved);
        for(android.content.UriPermission permission:
                getContext().getContentResolver().getPersistedUriPermissions()){
            if(permission.getUri().equals(uri)&&permission.isWritePermission()&&permission.isReadPermission()){
                destination=DocumentsContract.buildDocumentUriUsingTree(
                    uri,DocumentsContract.getTreeDocumentId(uri));
                try{if(documentMatches(destination,DocumentsContract.Document.MIME_TYPE_DIR,null)){recoverPending();return;}}
                catch(Exception unavailable){
                    // Retain the persisted grant on a transient provider outage;
                    // beginning a transfer still fails closed on native queries.
                    return;
                }
                destination=null;
            }
        }
        getContext().getSharedPreferences(PREFS,0).edit().remove(SELECTED).apply();
    }

    @PluginMethod
    public synchronized void getDestination(PluginCall call){
        restore();
        JSObject result=new JSObject();
        result.put("selected",destination!=null);
        result.put("recoveryPending",recoveryBlocked);
        android.content.SharedPreferences prefs=getContext().getSharedPreferences(PREFS,0);
        String recovered=prefs.getString("recovered_name",null);
        if(recovered!=null){
            result.put("recoveredName",recovered);
            result.put("recoveredFiles",prefs.getInt("recovered_files",0));
            result.put("recoveredLegacy",prefs.getBoolean("recovered_legacy",false));
            prefs.edit().remove("recovered_name").remove("recovered_files").remove("recovered_legacy").commit();
        }
        call.resolve(result);
    }

    @PluginMethod
    public synchronized void chooseDestination(PluginCall call){
        restore();
        if(recoveryBlocked||choosing||staging!=null||singleStaging!=null){call.reject("bridge_destination_busy");return;}
        Intent intent=new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION|
            Intent.FLAG_GRANT_WRITE_URI_PERMISSION|
            Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
        choosing=true;
        try{startActivityForResult(call,intent,"chosen");}
        catch(Exception error){choosing=false;call.reject("bridge_destination_picker_failed");}
    }

    @ActivityCallback
    private synchronized void chosen(PluginCall call,ActivityResult result){
        choosing=false;
        if(call==null)return;
        Intent data=result.getData();
        if(result.getResultCode()!=Activity.RESULT_OK||data==null||
            data.getData()==null){
            call.reject("bridge_destination_cancelled");return;
        }
        Uri uri=data.getData();
        try{
            getContext().getContentResolver().takePersistableUriPermission(
                uri,Intent.FLAG_GRANT_READ_URI_PERMISSION|
                    Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
            destination=DocumentsContract.buildDocumentUriUsingTree(
                uri,DocumentsContract.getTreeDocumentId(uri));
            if(!getContext().getSharedPreferences(PREFS,0).edit()
                .putString(SELECTED,uri.toString()).commit())
                throw new IllegalStateException();
            JSObject reply=new JSObject();reply.put("selected",true);
            call.resolve(reply);
        }catch(Exception error){call.reject("bridge_destination_permission_denied");}
    }

    @PluginMethod
    public synchronized void beginFolder(PluginCall call){
        restore();
        String name=call.getString("name");
        if(recoveryBlocked||choosing||destination==null||staging!=null||singleStaging!=null||!validName(name)){
            call.reject("bridge_destination_not_ready");return;
        }
        try{
            transferParent=ownerDirectory(call);
            name=availableName(name);
            // Visible while downloading: completed files can be opened at once.
            Uri temp=createFresh(parent(),
                DocumentsContract.Document.MIME_TYPE_DIR,
                availableName(withSuffix(name," (in corso)")));
            if(temp==null)throw new IllegalStateException();
            try{journal(temp,name,false);}catch(Exception error){DocumentsContract.deleteDocument(getContext().getContentResolver(),temp);throw error;}
            staging=temp;finalName=name;
            directories.clear();directories.put("",temp);files.clear();openedPaths.clear();
            JSObject result=new JSObject();result.put("started",true);
            call.resolve(result);
        }catch(Exception error){
            // Preserve the specific failure stage without leaking document paths or names.
            String detail="bridge_destination_create_failed";
            if(error instanceof SecurityException)detail+="_permission";
            else if(error instanceof java.io.FileNotFoundException)detail+="_provider";
            else if(error instanceof IllegalStateException &&
                error.getMessage()!=null &&
                error.getMessage().matches("bridge_destination_[a-z_]+"))
                detail=error.getMessage();
            android.util.Log.e("FreePTBridgeDestination","Download destination preparation failed",error);
            call.reject(detail);
        }
    }

    @PluginMethod
    public synchronized void makeDirectory(PluginCall call){
        if(staging==null){call.reject("bridge_destination_not_started");return;}
        try{
            String[] names=path(call);
            String target=key(names,names.length);
            if(directories.containsKey(target)||openedPaths.contains(target)){
                call.reject("bridge_destination_duplicate_path");return;
            }
            Uri parent=directories.get(key(names,names.length-1));
            if(parent==null)throw new IllegalArgumentException();
            Uri created=createFresh(parent,
                DocumentsContract.Document.MIME_TYPE_DIR,names[names.length-1]);
            if(created==null)throw new IllegalStateException();
            directories.put(target,created);
            call.resolve();
        }catch(Exception error){call.reject("bridge_destination_mkdir_failed");}
    }

    @PluginMethod
    public synchronized void openFile(PluginCall call){
        if(staging==null){call.reject("bridge_destination_not_started");return;}
        try{
            String[] names=path(call);
            Object raw=call.getData().opt("size");
            if(!(raw instanceof Number))throw new IllegalArgumentException();
            long size=((Number)raw).longValue();
            if(((Number)raw).doubleValue()!=(double)size||
                size<0||size>MAX_FILE_BYTES)throw new IllegalArgumentException();
            String mime=call.getString("mime","application/octet-stream");
            if(mime==null||mime.length()>160)throw new IllegalArgumentException();
            Uri parent=directories.get(key(names,names.length-1));
            if(parent==null)throw new IllegalArgumentException();
            String target=key(names,names.length);
            String fileName=names[names.length-1];
            if(openedPaths.contains(target)||directories.containsKey(target)||nameTakenIn(parent,fileName))
                throw new IllegalStateException("bridge_destination_exists");
            String type=mime.isEmpty()?"application/octet-stream":mime;
            Uri created=createFresh(parent,type,temporaryFileName(fileName,type));
            if(created==null)throw new IllegalStateException();
            openedPaths.add(target);
            String id=UUID.randomUUID().toString();
            files.put(id,new FileEntry(created,size,parent,fileName));
            JSObject result=new JSObject();result.put("fileId",id);
            call.resolve(result);
        }catch(Exception error){call.reject("bridge_destination_file_failed");}
    }

    @PluginMethod
    public synchronized void writeChunk(PluginCall call){
        FileEntry file=files.get(call.getString("fileId"));
        Object raw=call.getData().opt("offset");
        String encoded=call.getString("base64");
        if((staging==null&&singleStaging==null)||file==null||file.completed||
            !(raw instanceof Number)||encoded==null||
            encoded.length()>349528){
            call.reject("bridge_destination_write_invalid");return;
        }
        long offset=((Number)raw).longValue();
        if(((Number)raw).doubleValue()!=(double)offset||offset!=file.written){
            call.reject("bridge_destination_write_out_of_order");return;
        }
        try{
            byte[] bytes=Base64.decode(encoded,Base64.NO_WRAP);
            if(bytes.length<1||bytes.length>MAX_CHUNK||
                file.written>file.expected-bytes.length)
                throw new IllegalArgumentException();
            try(ParcelFileDescriptor fd=getContext().getContentResolver()
                    .openFileDescriptor(file.uri,"rw")){
                if(fd==null)throw new IllegalStateException();
                try(FileOutputStream out=new FileOutputStream(fd.getFileDescriptor())){
                    FileChannel channel=out.getChannel();
                    channel.position(offset);
                    ByteBuffer input=ByteBuffer.wrap(bytes);
                    while(input.hasRemaining())channel.write(input);
                }
            }
            file.written+=bytes.length;
            JSObject result=new JSObject();result.put("written",file.written);
            call.resolve(result);
        }catch(Exception error){call.reject("bridge_destination_write_failed");}
    }

    @PluginMethod
    public synchronized void commitFile(PluginCall call){
        FileEntry file=files.get(call.getString("fileId"));
        if((staging==null&&singleStaging==null)||file==null||file.completed||
            file.written!=file.expected){
            call.reject("bridge_destination_file_incomplete");return;
        }
        try{
            if(!documentMatches(file.uri,null,file.expected)){
                call.reject("bridge_destination_size_mismatch");return;
            }
        }catch(Exception error){call.reject("bridge_destination_verify_failed");return;}
        if(file.finalName!=null){
            try{
                if(nameTakenIn(file.parentDir,file.finalName))
                    throw new IllegalStateException("bridge_destination_exists");
                Uri renamed=DocumentsContract.renameDocument(
                    getContext().getContentResolver(),file.uri,file.finalName);
                if(renamed==null)throw new IllegalStateException();
                file.uri=renamed;
                try(Cursor c=getContext().getContentResolver().query(renamed,
                    new String[]{DocumentsContract.Document.COLUMN_DISPLAY_NAME},null,null,null)){
                    if(c==null||!c.moveToFirst()||!file.finalName.equals(c.getString(0)))
                        throw new IllegalStateException("bridge_destination_provider_renamed");
                }
            }catch(Exception error){call.reject("bridge_destination_publish_failed");return;}
        }
        file.completed=true;
        call.resolve();
    }

    @PluginMethod
    public synchronized void discardFile(PluginCall call){
        String id=call.getString("fileId");
        FileEntry file=files.get(id);
        if((staging==null&&singleStaging==null)||file==null){call.reject("bridge_destination_file_missing");return;}
        try{
            if(!DocumentsContract.deleteDocument(
                getContext().getContentResolver(),file.uri))
                throw new IllegalStateException();
            files.remove(id);
            call.resolve();
        }catch(Exception error){call.reject("bridge_destination_file_cleanup_failed");}
    }

    /** Stage a single file directly under the user's selected destination. */
    @PluginMethod
    public synchronized void beginSingleFile(PluginCall call){
        restore();
        String name=call.getString("name");
        String mime=call.getString("mime","application/octet-stream");
        Object raw=call.getData().opt("size");
        if(recoveryBlocked||choosing||destination==null||staging!=null||singleStaging!=null||
            !validName(name)||mime==null||mime.length()>160||
            !(raw instanceof Number)){
            call.reject("bridge_destination_not_ready");return;
        }
        long size=((Number)raw).longValue();
        if(((Number)raw).doubleValue()!=(double)size||
            size<0||size>MAX_FILE_BYTES){
            call.reject("bridge_destination_invalid_size");return;
        }
        try{
            transferParent=ownerDirectory(call);
            name=availableName(name);
            Uri temp=createFresh(parent(),
                mime.isEmpty()?"application/octet-stream":mime,
                temporaryFileName(name,mime));
            if(temp==null)throw new IllegalStateException();
            try{journal(temp,name,false);}catch(Exception error){DocumentsContract.deleteDocument(getContext().getContentResolver(),temp);throw error;}
            singleStaging=temp;singleName=name;
            files.clear();
            String id=UUID.randomUUID().toString();
            files.put(id,new FileEntry(temp,size));
            JSObject result=new JSObject();result.put("fileId",id);
            call.resolve(result);
        }catch(Exception error){
            // Preserve the specific failure stage without leaking document paths or names.
            String detail="bridge_destination_create_failed";
            if(error instanceof SecurityException)detail+="_permission";
            else if(error instanceof java.io.FileNotFoundException)detail+="_provider";
            else if(error instanceof IllegalStateException &&
                error.getMessage()!=null &&
                error.getMessage().matches("bridge_destination_[a-z_]+"))
                detail=error.getMessage();
            android.util.Log.e("FreePTBridgeDestination","Download destination preparation failed",error);
            call.reject(detail);
        }
    }

    @PluginMethod
    public synchronized void commitSingleFile(PluginCall call){
        if(singleStaging==null||files.size()!=1){
            call.reject("bridge_destination_not_started");return;
        }
        for(FileEntry entry:files.values()){
            if(!entry.completed){call.reject("bridge_destination_file_incomplete");return;}
        }
        try{
            if(targetExists(singleName))throw new IllegalStateException("bridge_destination_exists");
            Uri renamed=DocumentsContract.renameDocument(
                getContext().getContentResolver(),singleStaging,singleName);
            if(renamed==null)throw new IllegalStateException();
            singleStaging=renamed;
            journal(renamed);
            try(Cursor cursor=getContext().getContentResolver().query(renamed,
                new String[]{DocumentsContract.Document.COLUMN_DISPLAY_NAME},
                null,null,null)){
                if(cursor==null||!cursor.moveToFirst()||
                    !singleName.equals(cursor.getString(0)))
                    throw new IllegalStateException();
            }
            if(!documentMatches(renamed,null,files.values().iterator().next().expected))
                throw new IllegalStateException("bridge_destination_size_mismatch");
            forgetJournal();
            singleStaging=null;singleName=null;transferParent=null;files.clear();
            call.resolve();
        }catch(Exception error){call.reject("bridge_destination_commit_failed");}
    }

    @PluginMethod
    public synchronized void discardSingleFile(PluginCall call){
        if(singleStaging==null){call.resolve();return;}
        try{
            if(!DocumentsContract.deleteDocument(
                getContext().getContentResolver(),singleStaging))
                throw new IllegalStateException();
            forgetJournal();
            singleStaging=null;singleName=null;transferParent=null;files.clear();
            call.resolve();
        }catch(Exception error){call.reject("bridge_destination_cleanup_failed");}
    }

    @PluginMethod
    public synchronized void commitFolder(PluginCall call){
        if(staging==null){call.reject("bridge_destination_not_started");return;}
        for(FileEntry file:files.values()){
            if(!file.completed){call.reject("bridge_destination_files_incomplete");return;}
        }
        try{
            boolean partial=call.getData().optBoolean("partial",false);
            // A partial download must not masquerade as a complete folder.
            String publishName=finalName;
            if(partial){
                String suffix=" (parziale)";
                publishName=availableName(
                    finalName.substring(0,Math.min(finalName.length(),255-suffix.length()))+
                    suffix);
            }
            if(targetExists(publishName))
                throw new IllegalStateException("bridge_destination_exists");
            Uri renamed=DocumentsContract.renameDocument(
                getContext().getContentResolver(),staging,publishName);
            if(renamed==null)throw new IllegalStateException();
            staging=renamed;
            journal(renamed);
            try(Cursor c=getContext().getContentResolver().query(renamed,
                new String[]{DocumentsContract.Document.COLUMN_DISPLAY_NAME},
                null,null,null)){
                if(c==null||!c.moveToFirst()||!publishName.equals(c.getString(0)))
                    throw new IllegalStateException("bridge_destination_provider_renamed");
            }
            forgetJournal();
            staging=null;finalName=null;transferParent=null;
            directories.clear();files.clear();openedPaths.clear();
            JSObject result=new JSObject();result.put("name",publishName);
            result.put("partial",partial);
            call.resolve(result);
        }catch(Exception error){call.reject("bridge_destination_commit_failed");}
    }

    @PluginMethod
    public synchronized void discardFolder(PluginCall call){
        if(staging==null){call.resolve();return;}
        try{
            if(!DocumentsContract.deleteDocument(getContext().getContentResolver(),staging))
                throw new IllegalStateException();
            forgetJournal();
            staging=null;finalName=null;transferParent=null;
            directories.clear();files.clear();openedPaths.clear();
            call.resolve();
        }catch(Exception error){call.reject("bridge_destination_cleanup_failed");}
    }

    @PluginMethod
    public synchronized void clearDestination(PluginCall call){
        restore();
        if(recoveryBlocked||choosing||staging!=null||singleStaging!=null){call.reject("bridge_destination_busy");return;}
        destination=null;
        if(!getContext().getSharedPreferences(PREFS,0).edit()
            .remove(SELECTED).commit()){
            call.reject("bridge_destination_clear_failed");return;
        }
        call.resolve();
    }
}
