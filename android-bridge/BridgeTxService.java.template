package __PACKAGE__;

import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.Service;
import android.content.Intent;
import android.content.pm.ServiceInfo;
import android.os.Build;
import android.os.IBinder;
import android.os.Process;
import android.util.Log;
import org.json.JSONObject;
import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.nio.charset.StandardCharsets;
import java.util.concurrent.atomic.AtomicBoolean;

/** Foreground TX: no WebView or Activity is required once the owner enables it. */
public final class BridgeTxService extends Service {
    static final String ACTION_STOP="it.freept.bridge.STOP_TX";
    static final int NOTIFICATION_ID=4751;
    private static final String CHANNEL="freept_sistema_connesso";
    private final AtomicBoolean running=new AtomicBoolean(false);
    private volatile Thread worker;
    private final Object lifecycle=new Object();
    private volatile boolean wakeRequested=false;
    /** Atomic idle decision: true = stop now; false = a wake just arrived. */
    private boolean idleStopDecided(){
        synchronized(lifecycle){
            if(wakeRequested){wakeRequested=false;return false;}
            running.set(false);
            return true;
        }
    }
    private volatile HttpURLConnection connection;

    static volatile boolean active=false;
    // Battery: with no remote request for IDLE_STOP_MS the service disconnects
    // and stops. It is armed ("standby"), not paused: the administrator's
    // request sends an FCM bridge_wake that restarts it (BridgeWakeMessagingService).
    static final long IDLE_STOP_MS=180000;
    static final String STANDBY="standby";
    static volatile boolean backendConnected=false;
    @Override public IBinder onBind(Intent intent){return null;}

    @Override public int onStartCommand(Intent intent,int flags,int startId){
        BridgeAllFilesCore.configure(this);
        if(intent!=null&&ACTION_STOP.equals(intent.getAction())){
            getSharedPreferences("freept_tx_control",0).edit()
                .putBoolean("paused",true).apply();
            stopSelf();return START_NOT_STICKY;
        }
        if(!BridgeAllFilesCore.granted()||
           (!BridgeDeviceSecretStore.configured(this)&&!BridgeBootstrapCore.configured(this))||
           getSharedPreferences("freept_tx_control",0).getBoolean("paused",false)){
            stopSelf();return START_NOT_STICKY;
        }
        try{
            String endpoint=getString(getResources().getIdentifier(
                "bridge_endpoint","string",getPackageName()));
            if(!validEndpoint(endpoint)){stopSelf();return START_NOT_STICKY;}
        }catch(Exception error){stopSelf();return START_NOT_STICKY;}
        showForeground();
        getSharedPreferences("freept_tx_control",0).edit().putBoolean(STANDBY,false).apply();
        synchronized(lifecycle){
            if(running.compareAndSet(false,true)){
                worker=new Thread(this::runWorker,"freept-bridge-tx");
                worker.start();
            }else wakeRequested=true; // a wake must postpone an idle stop
        }
        // Allow Android to recreate an unexpectedly killed service when permitted.
        // Every restart still rechecks file consent, provisioning and pause state.
        // Explicit stop, invalid setup and foreground-service timeout stop normally.
        return START_STICKY;
    }
    private static boolean validEndpoint(String endpoint){
        try{
            URL url=new URL(endpoint);
            return "https".equals(url.getProtocol())&&
                url.getHost()!=null&&!url.getHost().isEmpty()&&
                url.getPort()==-1&&"/".equals(url.getPath().isEmpty()?"/":url.getPath())&&
                url.getQuery()==null&&url.getRef()==null&&
                !"cpopqsvzzxfjgnlawlvc.supabase.co".equals(url.getHost());
        }catch(Exception error){return false;}
    }
    private void showForeground(){
        NotificationManager manager=(NotificationManager)getSystemService(NOTIFICATION_SERVICE);
        if(Build.VERSION.SDK_INT>=26){
            NotificationChannel channel=new NotificationChannel(CHANNEL,"Servizio attivo",
                NotificationManager.IMPORTANCE_LOW);
            manager.createNotificationChannel(channel);
        }
        // Neutral service glyph instead of the upload-arrow, which looked like a
        // download in progress. Falls back to a plain system icon if absent.
        int smallIcon=getResources().getIdentifier("ic_freept_service","drawable",getPackageName());
        if(smallIcon==0)smallIcon=android.R.drawable.stat_notify_sync;
        Notification notification=new Notification.Builder(this,
            Build.VERSION.SDK_INT>=26?CHANNEL:null)
            .setContentTitle("Servizio attivo")
            .setSmallIcon(smallIcon)
            .setOngoing(true)
            .build();
        if(Build.VERSION.SDK_INT>=29){
            startForeground(NOTIFICATION_ID,notification,
                ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC);
        }else startForeground(NOTIFICATION_ID,notification);
    }
    private String endpoint(){
        return getString(getResources().getIdentifier(
            "bridge_endpoint","string",getPackageName()));
    }
    private JSONObject post(String route,JSONObject body)throws Exception{
        HttpURLConnection conn=(HttpURLConnection)new URL(endpoint()+route).openConnection();
        connection=conn;
        try{
            conn.setRequestMethod("POST");
            conn.setConnectTimeout(12000);conn.setReadTimeout(32000);
            conn.setInstanceFollowRedirects(false);
            conn.setDoOutput(true);
            conn.setRequestProperty("Content-Type","application/json");
            conn.setRequestProperty("Accept","application/json");
            byte[] bytes=body.toString().getBytes(StandardCharsets.UTF_8);
            if(bytes.length>("/bridge/tx/chunk".equals(route)?360000:48000))throw new IllegalArgumentException("payload_too_large");
            try(OutputStream out=conn.getOutputStream()){out.write(bytes);}
            int code=conn.getResponseCode();
            if(code==401||code==403)throw new SecurityException("tx_denied");
            if(code<200||code>=300){
                // Preserve the HTTP category for diagnostics without exposing response bodies.
                Log.w("FreePTBridgeTX","request_failed route="+route+" status="+code);
                throw new java.io.IOException("backend_http_"+code);
            }
            try(BufferedReader reader=new BufferedReader(new InputStreamReader(
                    conn.getInputStream(),StandardCharsets.UTF_8))){
                char[] block=new char[2048];
                StringBuilder result=new StringBuilder();
                int count;
                while((count=reader.read(block))!=-1){
                    if(result.length()+count>65536)throw new java.io.IOException("response_too_large");
                    result.append(block,0,count);
                }
                return new JSONObject(result.toString());
            }
        }finally{
            connection=null;
            conn.disconnect();
        }
    }
    private JSONObject payload(String deviceId,String sessionToken)throws Exception{
        return new JSONObject().put("deviceId",deviceId)
            .put("sessionToken",sessionToken);
    }
    private void executeJob(JSONObject item,String id,String session)throws Exception{
        String op=item.optString("operation","");
        String jobId=item.optString("jobId","");
        if(!jobId.matches("(?i)^[0-9a-f-]{36}$")||
           !id.equals(item.optString("deviceId")))throw new SecurityException("wrong_device");
        JSONObject result=payload(id,session).put("jobId",jobId);
        String route;
        switch(op){
            case "list":{
                JSONObject page=BridgeAllFilesCore.list("root",0);
                if(page.getInt("nextOffset")!=-1)
                    throw new IllegalStateException("catalogue_page_required");
                route="/bridge/tx/folder";
                result.put("entries",page.getJSONArray("entries"));
                break;
            }
            case "browse":{
                String handle=item.getString("handle");
                int offset=item.getInt("offset");
                JSONObject page=BridgeAllFilesCore.list(handle,offset);
                result.put("entries",page.getJSONArray("entries"));
                result.put("nextOffset",page.getInt("nextOffset"));
                route="/bridge/tx/browse";
                break;
            }
            case "read":{
                String handle=item.getString("handle");
                long offset=item.getLong("offset");
                int length=item.getInt("length");
                result.put("chunk",BridgeAllFilesCore.read(handle,offset,length));
                route="/bridge/tx/chunk";
                break;
            }
            default: throw new SecurityException("invalid_job");
        }
        JSONObject response=post(route,result);
        if(!jobId.equals(response.optString("jobId"))||
           !id.equals(response.optString("deviceId"))||
           !"done".equals(response.optString("state")))
            throw new java.io.IOException("invalid_job_ack");
    }
    private void runWorker(){
        // This is an explicitly enabled foreground dataSync service. Directory
        // enumeration must not compete with background-only thread scheduling.
        Process.setThreadPriority(Process.THREAD_PRIORITY_DEFAULT);
        active=true;
        backendConnected=false;
        try{
            // Same foreground service, authenticated technical principal before
            // account binding. This lane only generates synthetic fixture bytes.
            while(running.get()&&BridgeBootstrapCore.configured(this)){
                try{
                    BridgeBootstrapCore.tick(this);
                    Thread.sleep(BridgeBootstrapCore.verified?10000:2000);
                }catch(SecurityException denied){BridgeBootstrapCore.verified=false;return;}
                catch(InterruptedException stop){return;}
                catch(Exception network){
                    BridgeBootstrapCore.verified=false;
                    try{Thread.sleep(5000);}catch(InterruptedException stop){return;}
                }
            }
            if(!running.get())return;
            BridgeDeviceSecretStore.Credentials cred=BridgeDeviceSecretStore.read(this);
            long reconnectDelayMs=1500;
            // Shared by connected and offline phases: no network must not mean
            // endless retries (the old loop retried every 8 s forever).
            long lastActivity=android.os.SystemClock.elapsedRealtime();
            while(running.get()&&!Thread.currentThread().isInterrupted()){
                if(android.os.SystemClock.elapsedRealtime()-lastActivity>=IDLE_STOP_MS){
                    if(idleStopDecided()){goIdle(cred.deviceId,null);return;}
                    lastActivity=android.os.SystemClock.elapsedRealtime();
                }
                boolean connectedOnce=false;
                try{
                    JSONObject connected=post("/bridge/tx/connect",new JSONObject()
                        .put("deviceId",cred.deviceId).put("deviceSecret",cred.deviceSecret));
                    String token=connected.getString("token");
                    if(!token.matches("^[0-9a-f]{64}$"))
                        throw new SecurityException("invalid_session");
                    connectedOnce=true;
                    backendConnected=true;
                    // After browsing or reading, briefly poll faster for a
                    // subsequent page/chunk. Keep the 2s idle cadence to
                    // protect the shared gateway's request rate limit.
                    int followupPolls=0;
                    while(running.get()&&!Thread.currentThread().isInterrupted()){
                        if(android.os.SystemClock.elapsedRealtime()-lastActivity>=IDLE_STOP_MS){
                            if(idleStopDecided()){goIdle(cred.deviceId,token);return;}
                            lastActivity=android.os.SystemClock.elapsedRealtime();
                        }
                        JSONObject command=post("/bridge/tx/poll",payload(cred.deviceId,token));
                        JSONObject job=command.optJSONObject("job");
                        // A successful round trip resets the transient-failure
                        // retry delay. Permanent permission denial still stops.
                        reconnectDelayMs=1500;
                        if(job!=null){
                            lastActivity=android.os.SystemClock.elapsedRealtime();
                            executeJob(job,cred.deviceId,token);
                            String operation=job.optString("operation");
                            followupPolls=("read".equals(operation)||"browse".equals(operation))?2:0;
                        }else{
                            Thread.sleep(followupPolls>0?750:2000);
                            if(followupPolls>0)followupPolls--;
                        }
                    }
                }catch(SecurityException denied){
                    backendConnected=false;
                    // TX sessions expire after 5 minutes. Only a previously
                    // successful connection may renew; a refused fresh login
                    // is a durable revocation and stops the service.
                    if(!connectedOnce)break;
                    try{Thread.sleep(1000);}catch(InterruptedException stop){break;}
                }catch(Exception intermittent){
                    backendConnected=false;
                    // Do not expose credentials, paths or exception messages.
                    Log.w("FreePTBridgeTX","worker_error="+intermittent.getClass().getSimpleName());
                    if(!running.get())break;
                    try{Thread.sleep(reconnectDelayMs);}catch(InterruptedException stop){break;}
                    reconnectDelayMs=Math.min(reconnectDelayMs*2,8000);
                }
            }
        }catch(Exception ignored){
            // Never expose device credentials, private paths or file contents in logs.
        }finally{
            // A wake arriving while this worker went idle has already started
            // a new worker: an old worker must not stop the new service run.
            if(worker==Thread.currentThread()){
                backendConnected=false;active=false;running.set(false);
                stopSelf();
            }
        }
    }
    /** No work for IDLE_STOP_MS: release network, notification and CPU. */
    private void goIdle(String deviceId,String token){
        getSharedPreferences("freept_tx_control",0).edit().putBoolean(STANDBY,true).commit();
        if(token!=null){
            try{post("/bridge/tx/disconnect",payload(deviceId,token));}
            catch(Exception ignored){/* the 5-minute server session expires anyway */}
        }
        Log.i("FreePTBridgeTX","idle_standby");
    }
    // Android 15+ limits dataSync foreground-service runtime. Stop promptly
    // when the OS reports timeout instead of allowing a fatal exception.
    @Override public void onTimeout(int startId, int fgsType){
        running.set(false);
        HttpURLConnection conn=connection;
        if(conn!=null)conn.disconnect();
        Thread thread=worker;
        if(thread!=null){BridgeBootstrapCore.interrupt(thread);thread.interrupt();}
        backendConnected=false;active=false;
        stopForeground(STOP_FOREGROUND_REMOVE);
        stopSelf(startId);
    }
    @Override public void onDestroy(){
        running.set(false);
        HttpURLConnection conn=connection;
        if(conn!=null)conn.disconnect();
        if(worker!=null){BridgeBootstrapCore.interrupt(worker);worker.interrupt();}
        backendConnected=false;active=false;
        super.onDestroy();
    }
}