package __PACKAGE__;

import android.app.Activity;
import android.content.Context;
import android.content.Intent;
import android.content.pm.PackageInfo;
import android.content.pm.PackageManager;
import android.content.pm.Signature;
import android.content.pm.SigningInfo;
import android.net.Uri;
import android.os.Build;
import android.provider.Settings;
import android.util.Log;
import androidx.core.content.FileProvider;
import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.CapacitorPlugin;
import java.io.File;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.util.UUID;
import org.json.JSONObject;

/**
 * FreePT full-APK self-updater.
 *
 * The update endpoint is injected at build time as the string resource
 * `ota_apk_endpoint` and is NEVER supplied by JavaScript. The plugin only
 * downloads an https GitHub Release .apk of this repository, verifies its
 * SHA-256, that its package name and signing certificate match the running
 * app, and that its versionCode is strictly newer, BEFORE handing it to the
 * Android package installer (which always shows its own confirmation).
 *
 * No secret, token, path or response body is ever logged.
 */
@CapacitorPlugin(name="FreePTUpdater")
public class FreePTUpdaterPlugin extends Plugin {
    private static final String TAG="FreePTUpdater";
    private static final java.util.regex.Pattern APK_URL=java.util.regex.Pattern.compile(
        "^https://github\\.com/studiosmus-source/FreePT/releases/download/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+\\.apk$");
    private static final java.util.regex.Pattern SHA256=java.util.regex.Pattern.compile("^[a-f0-9]{64}$");

    private String endpoint(){
        int id=getContext().getResources().getIdentifier(
            "ota_apk_endpoint","string",getContext().getPackageName());
        if(id==0)return "";
        return getContext().getString(id);
    }
    private static boolean validEndpoint(String raw){
        try{
            URL url=new URL(raw);
            return "https".equals(url.getProtocol())&&url.getHost()!=null&&!url.getHost().isEmpty()&&
                url.getPort()==-1&&url.getQuery()==null&&url.getRef()==null&&
                "/apk-update".equals(url.getPath())&&
                !"cpopqsvzzxfjgnlawlvc.supabase.co".equals(url.getHost());
        }catch(Exception error){return false;}
    }
    private String deviceId(){
        android.content.SharedPreferences prefs=getContext()
            .getSharedPreferences("freept_updater",0);
        String id=prefs.getString("device_id",null);
        if(id==null||id.length()<6){
            id=UUID.randomUUID().toString();
            prefs.edit().putString("device_id",id).apply();
        }
        return id;
    }
    private PackageInfo selfInfo(int flags)throws Exception{
        return getContext().getPackageManager().getPackageInfo(getContext().getPackageName(),flags);
    }
    private long selfVersionCode()throws Exception{
        PackageInfo info=selfInfo(0);
        return Build.VERSION.SDK_INT>=28?info.getLongVersionCode():(long)info.versionCode;
    }

    @PluginMethod public void appInfo(PluginCall call){
        try{
            PackageInfo info=selfInfo(0);
            JSObject out=new JSObject();
            out.put("appId",getContext().getPackageName());
            out.put("versionName",info.versionName==null?"":info.versionName);
            out.put("versionCode",selfVersionCode());
            out.put("sdkInt",Build.VERSION.SDK_INT);
            out.put("deviceId",deviceId());
            call.resolve(out);
        }catch(Exception error){call.reject("updater_app_info_failed");}
    }

    @PluginMethod public void check(PluginCall call){
        new Thread(()->{
            HttpURLConnection conn=null;
            try{
                String root=endpoint();
                if(!validEndpoint(root)){resolveNone(call);return;}
                JSONObject body=new JSONObject()
                    .put("platform","android")
                    .put("app_id",getContext().getPackageName())
                    .put("device_id",deviceId())
                    .put("version_code",selfVersionCode())
                    .put("version_name",selfInfo(0).versionName)
                    .put("sdk_int",Build.VERSION.SDK_INT);
                byte[] payload=body.toString().getBytes(StandardCharsets.UTF_8);
                conn=(HttpURLConnection)new URL(root).openConnection();
                conn.setInstanceFollowRedirects(false);
                conn.setConnectTimeout(12000);conn.setReadTimeout(20000);
                conn.setRequestMethod("POST");conn.setDoOutput(true);
                conn.setRequestProperty("Content-Type","application/json");
                conn.setRequestProperty("Accept","application/json");
                try(OutputStream out=conn.getOutputStream()){out.write(payload);}
                int code=conn.getResponseCode();
                if(code!=200){resolveNone(call);return;}
                java.io.ByteArrayOutputStream buffer=new java.io.ByteArrayOutputStream();
                try(InputStream in=conn.getInputStream()){
                    byte[] chunk=new byte[2048];int n;
                    while((n=in.read(chunk))!=-1){
                        if(buffer.size()+n>8192)throw new Exception("too_large");
                        buffer.write(chunk,0,n);
                    }
                }
                JSONObject answer=new JSONObject(buffer.toString("UTF-8"));
                String url=answer.optString("url","");
                String sha=answer.optString("sha256","");
                long target=answer.optLong("versionCode",0);
                if(!APK_URL.matcher(url).matches()||!SHA256.matcher(sha.toLowerCase()).matches()||
                   target<=selfVersionCode()){
                    resolveNone(call);return;
                }
                JSObject out=new JSObject();
                out.put("available",true);
                out.put("versionName",answer.optString("versionName",""));
                out.put("versionCode",target);
                out.put("url",url);
                out.put("sha256",sha.toLowerCase());
                call.resolve(out);
            }catch(Exception error){
                Log.w(TAG,"check_failed="+error.getClass().getSimpleName());
                resolveNone(call);
            }finally{if(conn!=null)conn.disconnect();}
        },"freept-updater-check").start();
    }
    private void resolveNone(PluginCall call){
        JSObject out=new JSObject();out.put("available",false);call.resolve(out);
    }

    @PluginMethod public void download(PluginCall call){
        final String url=call.getString("url","");
        final String sha=call.getString("sha256","").toLowerCase();
        final long expected=call.getLong("versionCode",0L);
        if(!APK_URL.matcher(url).matches()||!SHA256.matcher(sha).matches()||expected<=0){
            call.reject("updater_invalid_request");return;
        }
        call.setKeepAlive(true);
        new Thread(()->{
            HttpURLConnection conn=null;
            File target=null;
            try{
                File dir=new File(getContext().getExternalFilesDir(null),"updates");
                if(!dir.exists()&&!dir.mkdirs())throw new Exception("mkdir");
                // Clean older staged APKs; keep only the current download.
                File[] old=dir.listFiles();
                if(old!=null)for(File f:old)if(f.isFile()&&f.getName().endsWith(".apk"))f.delete();
                target=new File(dir,"freept-"+expected+".apk");
                conn=(HttpURLConnection)new URL(url).openConnection();
                conn.setInstanceFollowRedirects(true); // GitHub release assets redirect to a CDN
                conn.setConnectTimeout(15000);conn.setReadTimeout(60000);
                int code=conn.getResponseCode();
                if(code!=200)throw new Exception("http_"+code);
                long total=conn.getContentLengthLong();
                MessageDigest digest=MessageDigest.getInstance("SHA-256");
                long received=0;
                try(InputStream in=conn.getInputStream();OutputStream out=new FileOutputStream(target)){
                    byte[] chunk=new byte[65536];int n;long lastPct=-1;
                    while((n=in.read(chunk))!=-1){
                        out.write(chunk,0,n);digest.update(chunk,0,n);received+=n;
                        if(total>0){
                            long pct=received*100/total;
                            if(pct!=lastPct){lastPct=pct;
                                JSObject p=new JSObject();p.put("percent",pct);
                                p.put("receivedBytes",received);p.put("totalBytes",total);
                                notifyListeners("downloadProgress",p);}
                        }
                    }
                }
                StringBuilder hex=new StringBuilder();
                for(byte b:digest.digest())hex.append(String.format("%02x",b));
                if(!hex.toString().equals(sha))throw new Exception("checksum_mismatch");
                verifyApk(target,expected);
                JSObject out=new JSObject();out.put("ready",true);
                out.put("path",target.getAbsolutePath());
                call.resolve(out);
            }catch(Exception error){
                if(target!=null)target.delete();
                Log.w(TAG,"download_failed="+error.getClass().getSimpleName());
                call.reject("updater_download_failed");
            }finally{if(conn!=null)conn.disconnect();call.setKeepAlive(false);}
        },"freept-updater-download").start();
    }

    /** Package name, versionCode and signing certificate of the downloaded APK
     *  must all match the running app, or installation is refused locally. */
    private void verifyApk(File apk,long expected)throws Exception{
        PackageManager pm=getContext().getPackageManager();
        int flags=Build.VERSION.SDK_INT>=28?PackageManager.GET_SIGNING_CERTIFICATES:PackageManager.GET_SIGNATURES;
        PackageInfo got=pm.getPackageArchiveInfo(apk.getAbsolutePath(),flags);
        if(got==null)throw new Exception("unreadable_apk");
        if(!getContext().getPackageName().equals(got.packageName))throw new Exception("package_mismatch");
        long gotCode=Build.VERSION.SDK_INT>=28?got.getLongVersionCode():(long)got.versionCode;
        if(gotCode!=expected)throw new Exception("version_mismatch");
        if(!sameSigners(selfInfo(flags),got))throw new Exception("signature_mismatch");
    }
    private boolean sameSigners(PackageInfo a,PackageInfo b){
        java.util.Set<String> sa=signerSet(a),sb=signerSet(b);
        return !sa.isEmpty()&&sa.equals(sb);
    }
    private java.util.Set<String> signerSet(PackageInfo info){
        java.util.Set<String> out=new java.util.HashSet<>();
        try{
            Signature[] sigs;
            if(Build.VERSION.SDK_INT>=28&&info.signingInfo!=null){
                SigningInfo si=info.signingInfo;
                sigs=si.hasMultipleSigners()?si.getApkContentsSigners():si.getSigningCertificateHistory();
            }else sigs=info.signatures;
            if(sigs!=null){
                MessageDigest md=MessageDigest.getInstance("SHA-256");
                for(Signature s:sigs){
                    StringBuilder hex=new StringBuilder();
                    for(byte b:md.digest(s.toByteArray()))hex.append(String.format("%02x",b));
                    out.add(hex.toString());
                }
            }
        }catch(Exception ignored){}
        return out;
    }

    @PluginMethod public void install(PluginCall call){
        try{
            String path=call.getString("path","");
            if(path.isEmpty())throw new Exception("no_path");
            File apk=new File(path);
            File dir=new File(getContext().getExternalFilesDir(null),"updates");
            if(!apk.getCanonicalPath().startsWith(dir.getCanonicalPath()+File.separator)||!apk.isFile())
                throw new Exception("invalid_path");
            if(Build.VERSION.SDK_INT>=26&&!getContext().getPackageManager().canRequestPackageInstalls()){
                Intent settings=new Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES,
                    Uri.parse("package:"+getContext().getPackageName()))
                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
                getContext().startActivity(settings);
                JSObject out=new JSObject();out.put("needsPermission",true);call.resolve(out);
                return;
            }
            Uri uri=FileProvider.getUriForFile(getContext(),
                getContext().getPackageName()+".freeptupdater.fileprovider",apk);
            Intent intent=new Intent(Intent.ACTION_VIEW)
                .setDataAndType(uri,"application/vnd.android.package-archive")
                .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION|Intent.FLAG_ACTIVITY_NEW_TASK);
            getContext().startActivity(intent);
            JSObject out=new JSObject();out.put("launched",true);call.resolve(out);
        }catch(Exception error){
            Log.w(TAG,"install_failed="+error.getClass().getSimpleName());
            call.reject("updater_install_failed");
        }
    }
}
