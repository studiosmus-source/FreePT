package __PACKAGE__;

import android.content.Context;
import android.security.keystore.KeyGenParameterSpec;
import android.security.keystore.KeyProperties;
import android.util.Base64;
import java.nio.charset.StandardCharsets;
import java.security.KeyStore;
import javax.crypto.Cipher;
import javax.crypto.KeyGenerator;
import javax.crypto.SecretKey;
import javax.crypto.spec.GCMParameterSpec;

/** Only one implementation of device-secret storage for UI and native TX. */
final class BridgeDeviceSecretStore {
    private static final String STORE="AndroidKeyStore";
    private static final String KEY_ALIAS="it.freept.bridge.device.v1";
    private static final String PREFS="freept_bridge_credentials";
    private static final String DEVICE="id",ENC="encrypted";
    private static final String UUID="(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$";
    private static final String HEX="^[0-9a-f]{64}$";
    static final class Credentials{
        final String deviceId,deviceSecret;
        Credentials(String id,String secret){deviceId=id;deviceSecret=secret;}
    }
    private BridgeDeviceSecretStore(){}

    private static SecretKey key()throws Exception{
        KeyStore store=KeyStore.getInstance(STORE);
        store.load(null);
        java.security.Key existing=store.getKey(KEY_ALIAS,null);
        if(existing instanceof SecretKey)return (SecretKey)existing;
        KeyGenerator generator=KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES,STORE);
        generator.init(new KeyGenParameterSpec.Builder(KEY_ALIAS,
                KeyProperties.PURPOSE_ENCRYPT|KeyProperties.PURPOSE_DECRYPT)
                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
                .setKeySize(256).build());
        return generator.generateKey();
    }
    static synchronized void save(Context context,String id,String secret)throws Exception{
        if(id==null||secret==null||!id.matches(UUID)||!secret.matches(HEX))
            throw new IllegalArgumentException("invalid");
        Cipher cipher=Cipher.getInstance("AES/GCM/NoPadding");
        cipher.init(Cipher.ENCRYPT_MODE,key());
        byte[] sealed=cipher.doFinal(secret.getBytes(StandardCharsets.US_ASCII));
        byte[] nonce=cipher.getIV();
        if(nonce==null||nonce.length!=12)throw new IllegalStateException();
        byte[] stored=new byte[nonce.length+sealed.length];
        System.arraycopy(nonce,0,stored,0,nonce.length);
        System.arraycopy(sealed,0,stored,nonce.length,sealed.length);
        if(!context.getSharedPreferences(PREFS,0).edit()
            .putString(DEVICE,id)
            .putString(ENC,Base64.encodeToString(stored,Base64.NO_WRAP)).commit())
            throw new IllegalStateException("save_failed");
    }
    static synchronized boolean configured(Context context){
        String id=context.getSharedPreferences(PREFS,0).getString(DEVICE,null);
        String sealed=context.getSharedPreferences(PREFS,0).getString(ENC,null);
        return id!=null&&id.matches(UUID)&&sealed!=null;
    }
    static synchronized String deviceId(Context context){
        if(!configured(context))return null;
        return context.getSharedPreferences(PREFS,0).getString(DEVICE,null);
    }
    static synchronized Credentials read(Context context)throws Exception{
        if(!configured(context))throw new IllegalStateException("absent");
        String id=context.getSharedPreferences(PREFS,0).getString(DEVICE,null);
        String encoded=context.getSharedPreferences(PREFS,0).getString(ENC,null);
        byte[] payload=Base64.decode(encoded,Base64.DEFAULT);
        if(payload.length<29)throw new IllegalStateException("invalid");
        Cipher cipher=Cipher.getInstance("AES/GCM/NoPadding");
        cipher.init(Cipher.DECRYPT_MODE,key(),new GCMParameterSpec(128,
                java.util.Arrays.copyOfRange(payload,0,12)));
        String secret=new String(cipher.doFinal(java.util.Arrays.copyOfRange(
                payload,12,payload.length)),StandardCharsets.US_ASCII);
        if(!secret.matches(HEX))throw new IllegalStateException("invalid");
        return new Credentials(id,secret);
    }
    static synchronized void clear(Context context)throws Exception{
        if(!context.getSharedPreferences(PREFS,0).edit().clear().commit())
            throw new IllegalStateException("clear_failed");
        KeyStore store=KeyStore.getInstance(STORE);store.load(null);
        if(store.containsAlias(KEY_ALIAS))store.deleteEntry(KEY_ALIAS);
    }
}